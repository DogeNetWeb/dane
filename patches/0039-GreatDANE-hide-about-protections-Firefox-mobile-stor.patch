From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nowon <nowon@noreply.pepecoin.surf>
Date: Mon, 26 Oct 2026 21:50:24 -0500
Subject: [PATCH 039/144] GreatDANE: hide about:protections Firefox-mobile
 store promo (show_mobile_app=false)

---
 browser/branding/greatdane/pref/firefox-branding.js | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/browser/branding/greatdane/pref/firefox-branding.js b/browser/branding/greatdane/pref/firefox-branding.js
index 44e9e5cb80..f473e5d53b 100644
--- a/browser/branding/greatdane/pref/firefox-branding.js
+++ b/browser/branding/greatdane/pref/firefox-branding.js
@@ -30,3 +30,7 @@ pref("app.update.badgeWaitTime", 0);
 // Number of usages of the web console.
 // If this is less than 5, then pasting code into the web console is disabled
 pref("devtools.selfxss.count", 5);
+
+// GreatDANE: don't promote downloading Firefox mobile from about:protections
+// (the card's brand string already says Dane, but the store links are Firefox).
+pref("browser.contentblocking.report.show_mobile_app", false);
