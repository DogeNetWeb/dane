diff --git a/browser/components/greatdane/test/marionette/run_gd_firefox_import.py b/browser/components/greatdane/test/marionette/run_gd_firefox_import.py
new file mode 100644
index 0000000000..bafe7d5142
--- /dev/null
+++ b/browser/components/greatdane/test/marionette/run_gd_firefox_import.py
@@ -0,0 +1,380 @@
+# Dane: synthetic Firefox-import test.
+# Builds a fake Firefox application-support tree (profiles.ini + places.sqlite
+# with dummy bookmarks and history), points the mozilla-firefox migrator at it
+# via greatdane.migrate.firefoxAppDir, imports into a throwaway Dane profile,
+# checks source listing + counts, then deletes both trees.
+# NEVER reads ~/Library/Application Support/Firefox or real passwords.
+#
+#   python3 run_gd_firefox_import.py [path/to/greatdane]
+import os, shutil, sqlite3, subprocess, sys, tempfile, time
+from marionette_driver.marionette import Marionette
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+TREE = os.path.abspath(os.path.join(HERE, "../../../../.."))
+APP = (
+    sys.argv[1]
+    if len(sys.argv) > 1
+    else TREE + "/obj-gd/dist/Dane.app/Contents/MacOS/greatdane"
+)
+
+EXPECTED_BOOKMARKS = 3
+EXPECTED_HISTORY_URLS = 2
+
+def make_fake_firefox_appdir(root):
+    """Create profiles.ini + Profiles/gd-fake.default/places.sqlite."""
+    prof = os.path.join(root, "Profiles", "gd-fake.default")
+    os.makedirs(prof, exist_ok=True)
+    with open(os.path.join(root, "profiles.ini"), "w") as f:
+        f.write(
+            "[General]\n"
+            "StartWithLastProfile=1\n"
+            "Version=2\n"
+            "\n"
+            "[Profile0]\n"
+            "Name=GD Fake Firefox\n"
+            "IsRelative=1\n"
+            "Path=Profiles/gd-fake.default\n"
+            "Default=1\n"
+        )
+
+    db = os.path.join(prof, "places.sqlite")
+    conn = sqlite3.connect(db)
+    c = conn.cursor()
+    c.executescript(
+        """
+        CREATE TABLE moz_places (
+          id INTEGER PRIMARY KEY,
+          url LONGVARCHAR,
+          title LONGVARCHAR,
+          rev_host LONGVARCHAR,
+          visit_count INTEGER DEFAULT 0,
+          hidden INTEGER DEFAULT 0,
+          typed INTEGER DEFAULT 0,
+          frecency INTEGER DEFAULT -1,
+          last_visit_date INTEGER,
+          guid TEXT,
+          foreign_count INTEGER DEFAULT 0,
+          url_hash INTEGER DEFAULT 0 NOT NULL,
+          description TEXT,
+          preview_image_url TEXT,
+          origin_id INTEGER
+        );
+        CREATE TABLE moz_bookmarks (
+          id INTEGER PRIMARY KEY,
+          type INTEGER,
+          fk INTEGER,
+          parent INTEGER,
+          position INTEGER,
+          title LONGVARCHAR,
+          keyword_id INTEGER,
+          folder_type TEXT,
+          dateAdded INTEGER,
+          lastModified INTEGER,
+          guid TEXT,
+          syncStatus INTEGER DEFAULT 0,
+          syncChangeCounter INTEGER DEFAULT 1
+        );
+        CREATE TABLE moz_historyvisits (
+          id INTEGER PRIMARY KEY,
+          from_visit INTEGER,
+          place_id INTEGER,
+          visit_date INTEGER,
+          visit_type INTEGER,
+          session INTEGER
+        );
+        """
+    )
+
+    now = int(time.time() * 1_000_000)
+    # Root folder tree (Firefox GUIDs are 12 chars).
+    roots = [
+        (1, 2, None, 0, 0, "", "root________"),
+        (2, 2, None, 1, 0, "Bookmarks Menu", "menu________"),
+        (3, 2, None, 1, 1, "Bookmarks Toolbar", "toolbar_____"),
+        (4, 2, None, 1, 2, "Tags", "tags________"),
+        (5, 2, None, 1, 3, "Other Bookmarks", "unfiled_____"),
+        (6, 2, None, 1, 4, "Mobile Bookmarks", "mobile______"),
+    ]
+    for row in roots:
+        c.execute(
+            "INSERT INTO moz_bookmarks "
+            "(id, type, fk, parent, position, title, dateAdded, lastModified, guid) "
+            "VALUES (?,?,?,?,?,?,?,?,?)",
+            (*row[:6], now, now, row[6]),
+        )
+
+    places = [
+        (1, "https://example.com/gd-bm-1", "GD Bookmark One", "moc.elpmaxe.", "bbbbbbbbbbb1"),
+        (2, "https://example.com/gd-bm-2", "GD Bookmark Two", "moc.elpmaxe.", "bbbbbbbbbbb2"),
+        (3, "https://example.org/gd-bm-3", "GD Bookmark Three", "gro.elpmaxe.", "bbbbbbbbbbb3"),
+        (4, "https://example.net/gd-hist-1", "GD History One", "ten.elpmaxe.", "hhhhhhhhhhh1"),
+        (5, "https://example.net/gd-hist-2", "GD History Two", "ten.elpmaxe.", "hhhhhhhhhhh2"),
+    ]
+    for pid, url, title, rev, guid in places:
+        c.execute(
+            "INSERT INTO moz_places "
+            "(id, url, title, rev_host, visit_count, hidden, typed, frecency, "
+            " last_visit_date, guid, foreign_count, url_hash) "
+            "VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
+            (pid, url, title, rev, 1 if pid >= 4 else 0, 0, 0, 100, now, guid, 0, 0),
+        )
+
+    # 3 toolbar bookmarks
+    for i, pid in enumerate((1, 2, 3)):
+        c.execute(
+            "INSERT INTO moz_bookmarks "
+            "(type, fk, parent, position, title, dateAdded, lastModified, guid) "
+            "VALUES (1,?,?,?,?,?,?,?)",
+            (pid, 3, i, places[pid - 1][2], now, now, f"bm{i:010d}"),
+        )
+
+    # 2 history visits (visit_type 1 = TRANSITION_LINK)
+    for i, pid in enumerate((4, 5)):
+        c.execute(
+            "INSERT INTO moz_historyvisits "
+            "(from_visit, place_id, visit_date, visit_type, session) "
+            "VALUES (0,?,?,1,0)",
+            (pid, now - i * 1000),
+        )
+        c.execute(
+            "UPDATE moz_places SET visit_count=1, last_visit_date=? WHERE id=?",
+            (now - i * 1000, pid),
+        )
+
+    conn.commit()
+    conn.close()
+    return prof
+
+
+fake_root = tempfile.mkdtemp(prefix="gd-fake-firefox-")
+dane_prof = tempfile.mkdtemp(prefix="gd-import-dst-")
+fake_prof = make_fake_firefox_appdir(fake_root)
+
+# Escape paths for JS string prefs
+def js_str(s):
+    return s.replace("\\", "\\\\").replace('"', '\\"')
+
+user_js = os.path.join(dane_prof, "user.js")
+with open(user_js, "w") as f:
+    f.write('user_pref("marionette.port", 2841);\n')
+    f.write('user_pref("browser.aboutwelcome.enabled", false);\n')
+    f.write('user_pref("browser.shell.checkDefaultBrowser", false);\n')
+    f.write('user_pref("datareporting.policy.dataSubmissionEnabled", false);\n')
+    f.write(
+        f'user_pref("greatdane.migrate.firefoxAppDir", "{js_str(fake_root)}");\n'
+    )
+    f.write('user_pref("browser.migrate.mozilla-firefox.enabled", true);\n')
+
+p = subprocess.Popen(
+    [
+        APP,
+        "--headless",
+        "--marionette",
+        "-remote-allow-system-access",
+        "--no-remote",
+        "--profile",
+        dane_prof,
+        "--width",
+        "1280",
+        "--height",
+        "900",
+    ],
+    stdout=subprocess.DEVNULL,
+    stderr=subprocess.DEVNULL,
+)
+
+fails = 0
+
+def check(name, ok, info=""):
+    global fails
+    print(("PASS " if ok else "FAIL ") + name + (f"  [{info}]" if info and not ok else ""))
+    if not ok:
+        fails += 1
+
+rc = 1
+m = None
+try:
+    for _ in range(90):
+        try:
+            m = Marionette(host="127.0.0.1", port=2841)
+            m.start_session()
+            break
+        except Exception:
+            time.sleep(1)
+    else:
+        check("marionette connect", False, "timeout")
+        raise SystemExit(1)
+
+    m.set_context("chrome")
+    m.timeout.script = 120
+
+    # Sanity: override pref is set and does NOT point at real Firefox.
+    pref = m.execute_script(
+        'return Services.prefs.getStringPref("greatdane.migrate.firefoxAppDir", "");',
+        sandbox=None,
+    )
+    real_ff = os.path.expanduser("~/Library/Application Support/Firefox")
+    check(
+        "override pref set to synthetic tree",
+        pref == fake_root and pref != real_ff,
+        pref,
+    )
+    check(
+        "synthetic tree is not real Firefox path",
+        os.path.realpath(fake_root) != os.path.realpath(real_ff),
+        fake_root,
+    )
+
+    result = m.execute_async_script(
+        """
+        let done = arguments[arguments.length - 1];
+        (async () => {
+          const { MigrationUtils } = ChromeUtils.importESModule(
+            "resource:///modules/MigrationUtils.sys.mjs"
+          );
+          const { PlacesUtils } = ChromeUtils.importESModule(
+            "resource://gre/modules/PlacesUtils.sys.mjs"
+          );
+
+          let out = {
+            keyExists: MigrationUtils.migratorExists("mozilla-firefox"),
+            refreshStillThere: MigrationUtils.migratorExists("firefox"),
+          };
+
+          let migrator = await MigrationUtils.getMigrator("mozilla-firefox");
+          out.gotMigrator = !!migrator;
+          if (!migrator) {
+            done(out);
+            return;
+          }
+
+          out.hasPermissions = await migrator.hasPermissions();
+          out.sourceAvailable = await migrator.isSourceAvailable();
+          let profiles = await migrator.getSourceProfiles();
+          out.profileNames = (profiles || []).map(p => p.name);
+          out.profileCount = (profiles || []).length;
+
+          let types = await migrator.getMigrateData(
+            profiles && profiles[0] ? profiles[0] : null
+          );
+          out.hasBookmarks = !!(types & MigrationUtils.resourceTypes.BOOKMARKS);
+          out.hasHistory = !!(types & MigrationUtils.resourceTypes.HISTORY);
+          out.hasPasswords = !!(types & MigrationUtils.resourceTypes.PASSWORDS);
+
+          // Import bookmarks + history only (no passwords in the synthetic tree).
+          let resourceType =
+            MigrationUtils.resourceTypes.BOOKMARKS |
+            MigrationUtils.resourceTypes.HISTORY;
+
+          let ended = new Promise(resolve => {
+            let obs = (subject, topic, data) => {
+              Services.obs.removeObserver(obs, "Migration:Ended");
+              resolve(true);
+            };
+            Services.obs.addObserver(obs, "Migration:Ended");
+          });
+
+          let migratePromise = migrator.migrate(
+            resourceType,
+            false,
+            profiles && profiles[0] ? profiles[0] : null
+          );
+          out.migrationEnded = await Promise.race([
+            Promise.all([migratePromise, ended]).then(() => true),
+            new Promise(r => setTimeout(() => r(false), 60000)),
+          ]);
+
+          let children = [];
+          try {
+            let tree = await PlacesUtils.promiseBookmarksTree(
+              PlacesUtils.bookmarks.toolbarGuid
+            );
+            function walk(node) {
+              if (!node) return;
+              if (node.title && String(node.title).startsWith("GD Bookmark")) {
+                children.push(node.title);
+              }
+              for (let c of node.children || []) walk(c);
+            }
+            walk(tree);
+          } catch (ex) {
+            out.treeErr = String(ex);
+          }
+          out.importedBookmarkTitles = children;
+          out.importedBookmarks = children.length;
+
+          let hist = 0;
+          for (let url of [
+            "https://example.net/gd-hist-1",
+            "https://example.net/gd-hist-2",
+          ]) {
+            try {
+              if (await PlacesUtils.history.hasVisits(url)) {
+                hist++;
+              }
+            } catch (ex) {
+              out.histErr = (out.histErr || "") + String(ex) + ";";
+            }
+          }
+          out.importedHistoryUrls = hist;
+          done(out);
+        })().catch(ex => done({ error: String(ex), stack: ex.stack || "" }));
+        """,
+        sandbox=None,
+    )
+
+    if result.get("error"):
+        check("import script", False, result["error"] + " " + result.get("stack", ""))
+    else:
+        check("mozilla-firefox migrator registered", result.get("keyExists"), result)
+        check(
+            "firefox refresh migrator still registered",
+            result.get("refreshStillThere"),
+            result,
+        )
+        check("got mozilla-firefox migrator", result.get("gotMigrator"), result)
+        check("has permissions (synthetic)", result.get("hasPermissions"), result)
+        check("Firefox source available", result.get("sourceAvailable"), result)
+        check(
+            "Firefox appears as a source profile",
+            result.get("profileCount", 0) >= 1
+            and any("Fake" in n for n in result.get("profileNames") or []),
+            result,
+        )
+        check("offers bookmarks", result.get("hasBookmarks"), result)
+        check("offers history", result.get("hasHistory"), result)
+        # Passwords absent in synthetic tree (no logins.json) — OK.
+        check("migration finished", result.get("migrationEnded"), result)
+        check(
+            f"imported {EXPECTED_BOOKMARKS} bookmarks",
+            result.get("importedBookmarks") == EXPECTED_BOOKMARKS,
+            result,
+        )
+        check(
+            f"imported {EXPECTED_HISTORY_URLS} history urls",
+            result.get("importedHistoryUrls") == EXPECTED_HISTORY_URLS,
+            result,
+        )
+
+    rc = 0 if fails == 0 else 1
+finally:
+    try:
+        if m:
+            m.delete_session()
+    except Exception:
+        pass
+    try:
+        p.terminate()
+        p.wait(timeout=15)
+    except Exception:
+        try:
+            p.kill()
+        except Exception:
+            pass
+    # Delete synthetic Firefox tree and throwaway Dane profile.
+    shutil.rmtree(fake_root, ignore_errors=True)
+    shutil.rmtree(dane_prof, ignore_errors=True)
+    print(f"cleaned fake_firefox={fake_root} dane_profile={dane_prof}")
+
+print(f"RESULT {'PASS' if rc == 0 else 'FAIL'} fails={fails}")
+sys.exit(rc)
