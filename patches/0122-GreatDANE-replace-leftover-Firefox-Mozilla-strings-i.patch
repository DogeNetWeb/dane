diff --git a/browser/branding/greatdane/branding.nsi b/browser/branding/greatdane/branding.nsi
index 9168fa4f96..c3da93563b 100644
--- a/browser/branding/greatdane/branding.nsi
+++ b/browser/branding/greatdane/branding.nsi
@@ -11,19 +11,27 @@
 !define BrandFullNameInternal "Dane"
 !define BrandFullName         "Dane"
 !define CompanyName           "Pepecoin"
-!define URLInfoAbout          "https://dogecoin.surf"
-!define HelpLink              "https://support.mozilla.org"
+!define URLInfoAbout          "https://dane.surf/"
+!define HelpLink              "https://dane.surf/support/"
 
-!define URLStubDownloadX86 "https://download.mozilla.org/?os=win&lang=${AB_CD}&product=firefox-latest"
-!define URLStubDownloadAMD64 "https://download.mozilla.org/?os=win64&lang=${AB_CD}&product=firefox-latest"
-!define URLStubDownloadAArch64 "https://download.mozilla.org/?os=win64-aarch64&lang=${AB_CD}&product=firefox-latest"
-!define URLManualDownload "https://www.mozilla.org/${AB_CD}/firefox/installer-help/?channel=release&installer_lang=${AB_CD}"
-!define URLSystemRequirements "https://www.mozilla.org/firefox/system-requirements/"
+# Landing page, not a stable unversioned PE URL. Dane has no firefox-latest
+# equivalent. The public Windows installer (2026-11-10) is the versioned
+# unsigned Dane-153.7.0esr-win64.installer.exe; pinning that filename would
+# rot, and the stub CertCheck cannot succeed until a signed build exists.
+!define URLStubDownloadX86 "https://dane.surf/download/"
+!define URLStubDownloadAMD64 "https://dane.surf/download/"
+!define URLStubDownloadAArch64 "https://dane.surf/download/"
+!define URLManualDownload "https://dane.surf/download/"
+!define URLSystemRequirements "https://dane.surf/support/"
 !define Channel "unofficial"
 
-# The installer's certificate name and issuer expected by the stub installer
-!define CertNameDownload   "Mozilla Corporation"
-!define CertIssuerDownload "DigiCert Trusted G4 Code Signing RSA4096 SHA384 2021 CA1"
+# Do not keep Mozilla Corporation / Mozilla's DigiCert CA: Dane is not signed
+# as Mozilla, and the live Windows installer is not code-signed yet. These
+# values must be updated to the real subject CN and issuer when signing starts.
+# Until then the stub's PE trust check is expected to fail and fall back to
+# URLManualDownload (the Dane download page).
+!define CertNameDownload   "Pepecoin"
+!define CertIssuerDownload "Pepecoin"
 
 # Dialog units are used so the UI displays correctly with the system's DPI
 # settings.
