index c624ef02dc..330b027e57 100644
--- a/browser/components/greatdane/GreatDANE.sys.mjs
+++ b/browser/components/greatdane/GreatDANE.sys.mjs
@@ -36,16 +36,49 @@ export const GreatDANE = {
       let [coin, tld] = spec.trim().split(":");
       if (!coin || !tld) continue;
       let c = { coin, tld, state: "starting", ports: null, proc: null, restarts: 0 };
