       this._chains.set(tld, c);
-      this._spawn(c);
+      if (c.off) {
+        c.state = "off"; // fail closed: hosts get GD_NODE_NOT_READY
+      } else {
+        this._spawn(c);
+      }
     }
     this._publishEndpoints();
     Services.obs.addObserver(this, "quit-application");
+    Services.prefs.addObserver(PREF, this);
     lazy.registerAbout();
