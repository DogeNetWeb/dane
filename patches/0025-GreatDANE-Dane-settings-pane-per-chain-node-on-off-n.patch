+      return;
+    }
     if (topic == "browser-delayed-startup-finished") {
       // subject is the new browser window: watch its tabs for error pages
       subject.gBrowser?.addTabsProgressListener(lazy.ErrorTrap);
@@ -119,6 +152,8 @@ export const GreatDANE = {
     c.state = "down";
     this._publishEndpoints();
     c.lastExit = Date.now();
+    c.proc = null;
+    if (c.off) { c.state = "off"; return; }
