   appearance: {
     l10nId: "preferences-appearance-header",
     groupIds: ["appearance", "browserTheme", "relatedSettings"],
@@ -506,8 +512,36 @@ function register_module(categoryName, categoryObject) {
 
 document.addEventListener("DOMContentLoaded", init_all, { once: true });
 
+// GreatDANE: hide Mozilla data collection, VPN/Relay/product promos with a
+// stylesheet (display:none !important, so search can't unhide them). Sync
+// stays visible unless greatdane.prefs.hideSync is true. See PREFS-AUDIT.md.
+const GD_HIDE_CSS = `
+  [groupid="dataCollection"], [data-srd-groupid="dataCollection"],
+  [groupid="ipprotection"], [data-srd-groupid="ipprotection"],
+  #relayIntegrationBox, #category-more-from-mozilla, #topstories,
+  [data-category="paneMoreFromMozilla"] { display: none !important; }`;
+const GD_SYNC_CSS = `
+  #category-sync, [data-category="paneSync"] { display: none !important; }`;
+function gdApplyHiding() {
+  let el = document.getElementById("gd-hide-style");
+  if (!el) {
+    el = document.createElementNS("http://www.w3.org/1999/xhtml", "style");
+    el.id = "gd-hide-style";
+    document.documentElement.appendChild(el);
+  }
+  let hideSync = Services.prefs.getBoolPref("greatdane.prefs.hideSync", false);
+  el.textContent = GD_HIDE_CSS + (hideSync ? GD_SYNC_CSS : "");
+}
