   },
 
-  observe(subject, topic) {
+  // greatdane.<coin>.enabled (default true): run that chain's node.
+  // TODO(node settings iface): greatdane.<coin>.listen / .port / .maxInbound /
+  // .maxOutbound once greatdane-node accepts them (it only takes --only/--data
+  // /--ephemeral-ports/--dane-api/--stdio today).
+  _chainEnabled(coin) {
+    return Services.prefs.getBoolPref(PREF + coin + ".enabled", true);
+  },
+
+  setChainEnabled(c, on) {
+    if (on == !c.off) return;
+    c.off = !on;
+    log(c.coin, on ? "enabled" : "disabled");
