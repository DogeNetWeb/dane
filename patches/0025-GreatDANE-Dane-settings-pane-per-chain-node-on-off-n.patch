@@ -3639,6 +3639,11 @@ pref("greatdane.enabled", true);
 pref("greatdane.chains", "pep:pepe,doge:doge");
 pref("greatdane.node.path", "");
 pref("greatdane.node.dataDir", "");
+// Per-chain node on/off (Dane settings pane). Off = that TLD fails closed.
+pref("greatdane.pep.enabled", true);
+pref("greatdane.doge.enabled", true);
+// Hide Firefox Account/Sync in Settings (off: Dane is Firefox minus nothing).
+pref("greatdane.prefs.hideSync", false);
 // Fallback chain-host test (RegExp source, case-insensitive) used only when
 // the chain lookup fails; error pages for matching hosts stay ours.
 pref("greatdane.chainHostPattern", "\\.(pepe|doge)\\.?$");
