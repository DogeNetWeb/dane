+// GreatDANE: true if aHost is under a chain TLD (security.greatdane.tlsa_endpoints).
+// Such hosts must never resume a TLS session or send 0-RTT, so every
+// connection gets a fresh TLSA check.
+bool GreatDANEIsChainHost(const nsACString& aHost);
+
