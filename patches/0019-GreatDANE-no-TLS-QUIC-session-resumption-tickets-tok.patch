index 1440500d27..b867be035b 100644
--- a/security/manager/ssl/nsNSSCallbacks.cpp
+++ b/security/manager/ssl/nsNSSCallbacks.cpp
@@ -6,6 +6,8 @@
 #include "nsNSSCallbacks.h"
 
 #include "NSSSocketControl.h"
+#include "SSLServerCertVerification.h"
+#include "mozpkix/pkixnss.h"
 #include "EnabledSignatureSchemes.h"
 #include "ScopedNSSTypes.h"
 #include "SharedCertVerifier.h"
@@ -1123,6 +1125,18 @@ void HandshakeCallback(PRFileDesc* fd, void* client_data) {
   if (rv != SECSuccess) {
     return;
   }
+
+  // GreatDANE defense in depth: resumption is turned off for chain hosts, so a
+  // resumed handshake means something went wrong. The TLSA check didn't run
+  // on this connection, so fail closed. Re-checking here would block the
+  // socket thread on a network fetch.
+  if (channelInfo.resumed &&
+      GreatDANEIsChainHost(infoObject->GetHostName())) {
+    MOZ_LOG(gPIPNSSLog, LogLevel::Debug,
+            ("[%p] GreatDANE: resumed session for chain host, failing", fd));
+    infoObject->SetCanceled(MOZILLA_PKIX_ERROR_KEY_PINNING_FAILURE);
+    return;
+  }
   AccumulateCipherSuite(channelInfo);
 
   // Get the protocol version for telemetry
