     for (uint32_t attempt = 0; attempt < maxAttempts; ++attempt) {
@@ -713,7 +716,8 @@ nsresult Http3Session::ProcessEvents() {
         break;
       case Http3Event::Tag::ResumptionToken: {
         LOG(("Http3Session::ProcessEvents - ResumptionToken"));
-        if (StaticPrefs::network_http_http3_enable_0rtt() && !data.IsEmpty()) {
+        if (StaticPrefs::network_http_http3_enable_0rtt() && !data.IsEmpty() &&
+            !psm::GreatDANEIsChainHost(mConnInfo->GetOrigin())) {
           LOG(("Got a resumption token"));
           nsAutoCString peerId;
           mSocketControl->GetPeerId(peerId);
diff --git a/security/manager/ssl/SSLServerCertVerification.cpp b/security/manager/ssl/SSLServerCertVerification.cpp
index 629ed81a46..af2c9d0220 100644
--- a/security/manager/ssl/SSLServerCertVerification.cpp
+++ b/security/manager/ssl/SSLServerCertVerification.cpp
@@ -849,10 +849,21 @@ static bool GreatDANEFetch(const nsACString& aEndpoint, const nsACString& aHost,
              (n = PR_Recv(fd, buf, sizeof buf, 0, to)) > 0) {
         resp.Append(buf, n);
       }
+      // Accept HTTP/1.0 or 1.1 with exactly status 200. Anything we can't
+      // read unambiguously (truncated, oversized, chunked, odd status line)
+      // fails closed.
       int32_t b = resp.Find("\r\n\r\n");
-      if (StringBeginsWith(resp, "HTTP/1.1 200"_ns) && b > 0) {
-        aBody.Assign(Substring(resp, b + 4));
-        ok = true;
+      bool statusOk = (StringBeginsWith(resp, "HTTP/1.1 200"_ns) ||
+                       StringBeginsWith(resp, "HTTP/1.0 200"_ns)) &&
+                      resp.Length() > 12 &&
+                      (resp[12] == ' ' || resp[12] == '\r');
+      if (statusOk && b > 0 && resp.Length() < 16384) {
+        nsAutoCString headers(Substring(resp, 0, b));
+        ToLowerCase(headers);
+        if (headers.Find("transfer-encoding") < 0) {
+          aBody.Assign(Substring(resp, b + 4));
+          ok = true;
+        }
       }
     }
   }
@@ -861,26 +872,60 @@ static bool GreatDANEFetch(const nsACString& aEndpoint, const nsACString& aHost,
 }
 
 // The node emits flat JSON; pull one string or number field out of it.
+// Whitespace around ':' and values is allowed. Ambiguous input returns ""
+// (which every caller treats as a failure): the key twice, a string with
+// escapes or no closing quote, or a nested value.
+static bool GreatDANEIsWs(char c) {
+  return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+}
 static nsAutoCString GreatDANEField(const nsACString& aJson, const char* aKey) {
   nsAutoCString key;
   key.AppendLiteral("\"");
   key.Append(aKey);
-  key.AppendLiteral("\":");
+  key.AppendLiteral("\"");
   nsAutoCString out;
-  int32_t i = aJson.Find(key);
-  if (i < 0) return out;
-  i += key.Length();
   int32_t len = aJson.Length();
-  bool quoted = i < len && aJson[i] == '"';
-  if (quoted) i++;
-  while (i < len) {
-    char ch = aJson[i++];
-    if (quoted ? ch == '"' : (ch == ',' || ch == '}' || ch == ']')) break;
-    out.Append(ch);
+  int32_t found = -1;
+  for (int32_t from = 0;;) {
+    int32_t k = aJson.Find(key, from);
+    if (k < 0) break;
+    int32_t j = k + key.Length();
+    while (j < len && GreatDANEIsWs(aJson[j])) j++;
+    if (j < len && aJson[j] == ':') {
+      if (found >= 0) return out;  // duplicate key: ambiguous
+      found = j + 1;
+    }
+    from = k + 1;
+  }
+  if (found < 0) return out;
+  int32_t i = found;
+  while (i < len && GreatDANEIsWs(aJson[i])) i++;
+  if (i >= len) return out;
+  if (aJson[i] == '"') {
+    for (i++; i < len; i++) {
+      char ch = aJson[i];
+      if (ch == '"') return out;
+      if (ch == '\\' || (unsigned char)ch < 0x20) break;
+      out.Append(ch);
+    }
+    out.Truncate();  // escape or unterminated string
+    return out;
   }
+  if (aJson[i] == '{' || aJson[i] == '[') return out;
+  while (i < len && aJson[i] != ',' && aJson[i] != '}' &&
+         !GreatDANEIsWs(aJson[i])) {
+    out.Append(aJson[i++]);
+  }
+  while (i < len && GreatDANEIsWs(aJson[i])) i++;
+  if (i >= len || (aJson[i] != ',' && aJson[i] != '}')) out.Truncate();
   return out;
 }
 
+bool GreatDANEIsChainHost(const nsACString& aHost) {
+  nsAutoCString endpoint;
+  return GreatDANEEndpointFor(aHost, endpoint);
+}
+
 static GreatDANEVerdict GreatDANEVerify(const nsACString& aHost,
                                         const nsTArray<uint8_t>& aLeaf) {
   nsAutoCString endpoint;
