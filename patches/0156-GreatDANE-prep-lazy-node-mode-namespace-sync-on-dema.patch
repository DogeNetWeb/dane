+  int32_t timeoutSec = Preferences::GetInt("greatdane.node.lazyTimeoutSec", 10);
+  if (timeoutSec < 1) timeoutSec = 10;
+  if (timeoutSec > 60) timeoutSec = 60;
+
+  TimeStamp deadline =
+      TimeStamp::Now() + TimeDuration::FromSeconds(lazy ? timeoutSec : 5);
+  bool sawLoading = false;
+
+  for (;;) {
+    TimeDuration left = deadline - TimeStamp::Now();
+    if (left <= TimeDuration::FromMilliseconds(0)) {
+      break;
+    }
+    double ms = left.ToMilliseconds();
+    if (ms < 100.0) ms = 100.0;
+    PRIntervalTime to = PR_MillisecondsToInterval(static_cast<uint32_t>(ms));
