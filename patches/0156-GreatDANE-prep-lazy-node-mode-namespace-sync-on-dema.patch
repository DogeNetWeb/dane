+      // attempt already said the zone was still fetching.
+      if (sawLoading) {
+        PR_Sleep(PR_MillisecondsToInterval(100));
+        continue;
+      }
+      return GreatDANEVerdict::Fail;
+    }
+    // A blocked query (I/O timeout) in lazy mode, or any timeout after an
+    // explicit loading signal, is retried until the budget runs out and
+    // then reported as retryable Loading — never as key pinning.
+    // A malformed response is the existing fail-closed path unless we
+    // already know the zone is still being fetched.
+    if (fr == GreatDANEFetchResult::Timeout && (lazy || sawLoading)) {
