From: nowon <nowon@noreply.pepecoin.surf>
Date: Thu, 5 Nov 2026 19:44:14 -0600
Subject: [PATCH 083/144] GreatDANE Explore: probe via anonymous necko channel,
 skip while node blocked, expose real failure reason, no redirects

---
 .../greatdane/GreatDANEExplore.sys.mjs        | 114 +++++++++++++-----
 .../test/unit/test_GreatDANEExplore.js        |  47 ++++++++
 2 files changed, 132 insertions(+), 29 deletions(-)

diff --git a/browser/components/greatdane/GreatDANEExplore.sys.mjs b/browser/components/greatdane/GreatDANEExplore.sys.mjs
index 3844d69fc3..c61a084a7b 100644
--- a/browser/components/greatdane/GreatDANEExplore.sys.mjs
+++ b/browser/components/greatdane/GreatDANEExplore.sys.mjs
@@ -18,6 +18,7 @@
 const lazy = {};
 ChromeUtils.defineESModuleGetters(lazy, {
   GreatDANE: "resource:///modules/GreatDANE.sys.mjs",
+  NetUtil: "resource://gre/modules/NetUtil.sys.mjs",
   setTimeout: "resource://gre/modules/Timer.sys.mjs",
   clearTimeout: "resource://gre/modules/Timer.sys.mjs",
 });
@@ -334,38 +335,88 @@ export async function probeHttps(
   try {
     host = Services.io.newURI(url).host.toLowerCase();
   } catch (e) {
-    return { ok: false, status: 0, host: "", url, title: "" };
+    return { ok: false, status: 0, host: "", url, title: "", error: "BAD_URL" };
   }
-  if (!lazy.GreatDANE._chainFor(host)) {
-    return { ok: false, status: 0, host, url, title: host };
+  let chain = lazy.GreatDANE._chainFor(host);
+  if (!chain) {
+    return { ok: false, status: 0, host, url, title: host, error: "NOT_CHAIN" };
   }
-  let ctrl = new AbortController();
-  let timer = lazy.setTimeout(() => ctrl.abort(), Math.max(500, timeoutMs));
-  try {
-    let resp = await fetch(url, {
-      method: "GET",
-      redirect: "follow",
-      cache: "no-store",
-      credentials: "omit",
-      signal: ctrl.signal,
-    });
-    let status = resp.status || 0;
-    try {
-      await resp.arrayBuffer();
-    } catch (e) {}
-    let ok = status >= 200 && status < 500;
-    return { ok, status, host, url: "https://" + host + "/", title: host };
-  } catch (e) {
-    return {
-      ok: false,
-      status: 0,
-      host,
-      url: "https://" + host + "/",
-      title: host,
-    };
-  } finally {
-    lazy.clearTimeout(timer);
+  // While the node is not ready/syncing, ProtocolProxyFilter fails closed to
+  // DEAD_PORT, so any request dies instantly with PROXY_CONNECTION_REFUSED.
+  // That says nothing about the site: skip without spending budget.
+  let block = lazy.GreatDANE.blockReason(chain);
+  if (block) {
+    return { ok: false, skipped: block, status: 0, host, url, title: host };
   }
+  let base = { host, url: "https://" + host + "/", title: host };
+  return new Promise(resolve => {
+    let ch;
+    try {
+      // Normal necko channel: same ProtocolProxyFilter + PSM/TLSA verifier as
+      // a tab. Anonymous (no cookies/auth), uncached, no redirects followed
+      // (a 3xx still proves TLS+HTTP completed), body discarded, and no
+      // docshell, so no history/Places writes.
+      ch = lazy.NetUtil.newChannel({
+        uri: "https://" + host + "/",
+        loadUsingSystemPrincipal: true,
+        contentPolicyType: Ci.nsIContentPolicy.TYPE_OTHER,
+      }).QueryInterface(Ci.nsIHttpChannel);
+      ch.loadFlags |=
+        Ci.nsIRequest.LOAD_ANONYMOUS |
+        Ci.nsIRequest.LOAD_BYPASS_CACHE |
+        Ci.nsIRequest.INHIBIT_CACHING |
+        Ci.nsIChannel.LOAD_BACKGROUND;
+      ch.redirectionLimit = 0;
+    } catch (e) {
+      resolve({ ...base, ok: false, status: 0, error: "CHANNEL" });
+      return;
+    }
+    let settled = false;
+    let timedOut = false;
+    let bytes = 0;
+    let timer = lazy.setTimeout(() => {
+      timedOut = true;
+      ch.cancel(Cr.NS_ERROR_NET_TIMEOUT);
+    }, Math.max(500, timeoutMs));
+    ch.asyncOpen({
+      onStartRequest() {},
+      onDataAvailable(req, stream, off, count) {
+        bytes += count;
+        lazy.NetUtil.readInputStreamToString(stream, count);
+        if (bytes > 65536) {
+          req.cancel(Cr.NS_BINDING_ABORTED); // enough: server answered
+        }
+      },
+      onStopRequest(req, rv) {
+        if (settled) return;
+        settled = true;
+        lazy.clearTimeout(timer);
+        let status = 0;
+        try {
+          status = ch.responseStatus;
+        } catch (e) {}
+        let error = "";
+        if (timedOut) {
+          error = "TIMEOUT";
+        } else if (!Components.isSuccessCode(rv) && rv != Cr.NS_BINDING_ABORTED) {
+          // Real reason, e.g. NS_ERROR_UNKNOWN_HOST, PROXY_CONNECTION_REFUSED,
+          // or a PSM/TLSA failure (MOZILLA_PKIX_ERROR_KEY_PINNING_FAILURE).
+          try {
+            error = ch.securityInfo?.errorCodeString || "";
+          } catch (e) {}
+          if (!error) {
+            error = ChromeUtils.getXPCOMErrorName?.(rv) || "0x" + (rv >>> 0).toString(16);
+          }
+          if (rv == Cr.NS_ERROR_REDIRECT_LOOP && status >= 300 && status < 400) {
+            error = ""; // redirectionLimit hit: server answered with 3xx
+          }
+        }
+        let ok = !error && status >= 200 && status < 500;
+        if (!error && !ok) error = "HTTP_" + status;
+        resolve({ ...base, ok, status, error });
+      },
+    });
+  });
 }
 
