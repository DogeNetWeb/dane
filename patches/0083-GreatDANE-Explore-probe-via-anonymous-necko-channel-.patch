+      error: String(result.error || "").slice(0, 40),
     });
     if (result.ok) {
       liveByHost.set(result.host, {
diff --git a/browser/components/greatdane/test/unit/test_GreatDANEExplore.js b/browser/components/greatdane/test/unit/test_GreatDANEExplore.js
index 4ae8461daa..5716d2ddc2 100644
--- a/browser/components/greatdane/test/unit/test_GreatDANEExplore.js
+++ b/browser/components/greatdane/test/unit/test_GreatDANEExplore.js
@@ -90,3 +90,50 @@ add_task(function test_display_ttl_hides_expired_without_needing_probe() {
   Assert.equal(rows.length, 1);
   Assert.equal(rows[0].hostname, "fresh.doge");
 });
+
+add_task(async function test_probe_skips_when_node_blocked_no_network() {
+  const { probeHttps } = ChromeUtils.importESModule(
+    "resource:///modules/GreatDANEExplore.sys.mjs"
+  );
+  const { GreatDANE } = ChromeUtils.importESModule(
+    "resource:///modules/GreatDANE.sys.mjs"
+  );
+  let saved = new Map(GreatDANE._chains);
+  GreatDANE._chains.clear();
+  GreatDANE._chains.set("doge", { tld: "doge", state: "starting" });
+  try {
+    let r = await probeHttps("https://example.doge/", 1000);
+    Assert.equal(r.skipped, "GD_NODE_NOT_READY");
+    Assert.ok(!r.ok);
+    GreatDANE._chains.get("doge").state = "ready"; // no status => syncing
+    r = await probeHttps("https://example.doge/", 1000);
+    Assert.equal(r.skipped, "GD_NODE_SYNCING");
+    r = await probeHttps("https://example.com/", 1000);
+    Assert.equal(r.error, "NOT_CHAIN");
+  } finally {
+    GreatDANE._chains.clear();
+    for (let [k, v] of saved) GreatDANE._chains.set(k, v);
+  }
+});
+
+add_task(async function test_budget_persists_across_reload_and_time() {
+  do_get_profile();
+  const { readCache, writeCache, globalBudgetRemaining, hostProbedRecently } =
+    ChromeUtils.importESModule("resource:///modules/GreatDANEExplore.sys.mjs");
+  let now = Date.now();
+  await writeCache({
+    lastSampleAt: now,
+    live: [],
+    probeLog: [
+      { host: "a.doge", at: now - 1000, ok: true, status: 200, error: "" },
+      { host: "b.pepe", at: now - 2000, ok: false, status: 0, error: "TIMEOUT" },
+    ],
+  });
+  let c = await readCache(); // simulates restart: state only from disk
+  Assert.equal(c.probeLog.length, 2);
+  Assert.equal(globalBudgetRemaining(c, now), DEFAULT_GLOBAL_BUDGET - 2);
+  Assert.ok(hostProbedRecently(c, "a.doge", now));
+  let later = now + 8 * 24 * 60 * 60 * 1000;
+  Assert.equal(globalBudgetRemaining(c, later), DEFAULT_GLOBAL_BUDGET);
+  Assert.ok(!hostProbedRecently(c, "a.doge", later));
+});
