 # greatdane.prefs.hideSync, and the first-run update window logic.
 #   python3 run_gd_prefs.py [path/to/greatdane] [screens_dir]
+#
+# Round 5b (NGD 5A-L1): label this marionette prefs helper. The public
+# pre-image is blob 3f9e131 (after the round 5a tile retarget). A previous
+# label incorrectly cited a private pre-image and a shouldInitializeFeeds
+# one-line difference; that pref is not in this file.
 import os, shutil, subprocess, sys, tempfile, time
 from marionette_driver.marionette import Marionette
