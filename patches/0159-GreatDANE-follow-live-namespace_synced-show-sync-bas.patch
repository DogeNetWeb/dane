+++ b/browser/components/greatdane/GreatDANE.sys.mjs
@@ -52,6 +52,21 @@ export function lazyRetryMs(j, budgetMs) {
   return Math.max(1, Math.floor(n));
 }
 
+// Live lazy-mode sync decision (never latched). The node owns the
+// online/offline rule and reports namespace_synced plus
+// namespace_sync_basis / best_known_height on each status line.
+// Follow the flag when present — including height below activation
+// (an isolated offline node can be synced at a fixture tip).
+// Older nodes that omit the flag fall back to height catch-up.
+export function lazyNamespaceSynced(st) {
+  if (!st || typeof st != "object") return false;
+  if (typeof st.namespace_synced == "boolean") return st.namespace_synced;
+  if (!st.height) return false;
+  if (st.peer_height > 0) return st.height + 2 >= st.peer_height;
+  return true;
+}
+
+
 export function lazyTimeoutSec() {
   let s = Services.prefs.getIntPref(PREF + "node.lazyTimeoutSec", DEFAULT_LAZY_TIMEOUT_SEC);
   if (!Number.isInteger(s) || s < 1) s = DEFAULT_LAZY_TIMEOUT_SEC;
@@ -446,23 +461,17 @@ export const GreatDANE = {
     }
   },
 
-  // Synced = the node finished at least one pass and is not behind what its
-  // peers advertise. Until then chain names are not resolvable, by design.
+  // Synced = the ownership fold can be trusted for "unowned" (and for
+  // routing). Until then chain names stay fail-closed, by design.
   _synced(c) {
     let st = c.status;
     if (c.state != "ready" || !st) return false;
-    // An empty or stale chain is never "synced", even with no peers to ask.
+    if (this._lazyEnabled()) return lazyNamespaceSynced(st);
+    // Full mode: an empty or pre-activation chain is never "synced",
+    // even with no peers to ask.
     if (!st.height || st.height < (st.activation || 0)) return false;
     // A node at the tip keeps its pass open to follow new blocks, so
     // passes can stay 0 forever: a peer's height claim settles it alone.
-    if (this._lazyEnabled()) {
-      // Prefer the node's namespace_synced flag. If an older node omits it,
-      // fall back to the same height catch-up used in full mode (do not
-      // wait for a zone-walk pass that a lazy node may never run).
-      if (typeof st.namespace_synced == "boolean") return st.namespace_synced;
-      if (st.peer_height > 0) return st.height + 2 >= st.peer_height;
-      return true;
-    }
     if (st.peer_height > 0) return st.height + 2 >= st.peer_height;
     return st.passes >= 1;
   },
