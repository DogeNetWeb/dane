---
 mozconfig        | 11 +++++++++++
 mozconfig-x86_64 |  4 ++++
 2 files changed, 15 insertions(+)
 create mode 100644 mozconfig

diff --git a/mozconfig b/mozconfig
new file mode 100644
index 0000000000..67b3b3baf1
--- /dev/null
+++ b/mozconfig
@@ -0,0 +1,11 @@
+ac_add_options --enable-application=browser
+ac_add_options --with-branding=browser/branding/greatdane
+ac_add_options --with-app-basename=GreatDANE
+ac_add_options --disable-tests
+ac_add_options --disable-debug
+ac_add_options --disable-crashreporter
+mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-gd
+# Updates: ESR update channel; updater accepts only greatdane-esr MARs (matches updates/make-mars.sh).
+ac_add_options --enable-update-channel=esr
+export MAR_CHANNEL_ID=greatdane-esr
+export ACCEPTED_MAR_CHANNEL_IDS=greatdane-esr
diff --git a/mozconfig-x86_64 b/mozconfig-x86_64
index 4e4ec14870..dbdd9db2a5 100644
--- a/mozconfig-x86_64
+++ b/mozconfig-x86_64
@@ -9,3 +9,7 @@ ac_add_options --disable-crashreporter
 mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-gd-x86_64
 ac_add_options --with-onnx-runtime
 ac_add_options --enable-bootstrap=onnxruntime-x86_64-apple-darwin
+# Updates: ESR update channel; updater accepts only greatdane-esr MARs (matches updates/make-mars.sh).
+ac_add_options --enable-update-channel=esr
+export MAR_CHANNEL_ID=greatdane-esr
+export ACCEPTED_MAR_CHANNEL_IDS=greatdane-esr
