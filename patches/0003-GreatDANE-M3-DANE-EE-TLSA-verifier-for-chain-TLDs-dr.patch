+  // GreatDANE: chain TLDs are verified by on-chain TLSA only (see above).
+  {
+    GreatDANEVerdict v =
+        GreatDANEVerify(mHostName, mPeerCertChain.ElementAt(0));
+    if (v != GreatDANEVerdict::NotChain) {
+      MOZ_LOG(gPIPNSSLog, LogLevel::Debug,
+              ("[%" PRIx64 "] GreatDANE %s", mAddrForLogging,
+               v == GreatDANEVerdict::Match ? "match" : "fail"));
