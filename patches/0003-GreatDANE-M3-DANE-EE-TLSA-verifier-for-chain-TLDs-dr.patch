+// ---- GreatDANE (M3): on-chain DANE-EE verification for chain TLDs ---------
+// For a host under a TLD listed in security.greatdane.tlsa_endpoints the web
+// PKI is never consulted: the leaf's SPKI must match the TLSA record the local
+// greatdane-node folded from the chain (3 1 1 = SHA-256 of the SPKI). Anything
+// else (unowned name, no TLSA, node unreachable, mismatch) fails closed with a
+// non-overridable error. Names/validity are ignored, as RFC 7671 says for EE.
+enum class GreatDANEVerdict { NotChain, Match, Fail };
+
+static bool GreatDANEEndpointFor(const nsACString& aHost, nsACString& aEndpoint) {
+  nsAutoCString host(aHost);
+  ToLowerCase(host);
+  if (StringEndsWith(host, "."_ns)) host.Truncate(host.Length() - 1);
+  nsAutoCString list;
+  {
+    auto lock = StaticPrefs::security_greatdane_tlsa_endpoints();
+    list.Assign(*lock);
+  }
+  for (const nsACString& entry : list.Split(',')) {
+    int32_t eq = entry.FindChar('=');
+    if (eq <= 0) continue;
+    nsAutoCString tld(Substring(entry, 0, eq));
+    tld.Trim(" ");
+    ToLowerCase(tld);
+    if (host.Equals(tld) || StringEndsWith(host, "."_ns + tld)) {
+      aEndpoint.Assign(Substring(entry, eq + 1));
+      aEndpoint.Trim(" ");
+      return true;
+    }
+  }
+  return false;
+}
+
+// Blocking loopback GET; runs on a cert verification thread, never main.
+static bool GreatDANEFetch(const nsACString& aEndpoint, const nsACString& aHost,
+                           nsACString& aBody) {
+  int32_t colon = aEndpoint.RFindChar(':');
+  if (colon <= 0) return false;
+  nsAutoCString ip(Substring(aEndpoint, 0, colon));
+  nsresult err;
+  int32_t port = nsAutoCString(Substring(aEndpoint, colon + 1)).ToInteger(&err);
+  if (NS_FAILED(err) || port <= 0 || port > 65535) return false;
+  if (!ip.EqualsLiteral("127.0.0.1")) return false;  // loopback only
+  for (uint32_t i = 0; i < aHost.Length(); i++) {
+    char ch = aHost.CharAt(i);
+    if (!(isalnum((unsigned char)ch) || ch == '.' || ch == '-')) return false;
+  }
+  PRNetAddr addr;
+  if (PR_StringToNetAddr(ip.get(), &addr) != PR_SUCCESS) return false;
+  addr.inet.port = PR_htons((uint16_t)port);
+  PRFileDesc* fd = PR_OpenTCPSocket(PR_AF_INET);
+  if (!fd) return false;
+  bool ok = false;
+  PRIntervalTime to = PR_SecondsToInterval(5);
+  if (PR_Connect(fd, &addr, to) == PR_SUCCESS) {
+    nsAutoCString req;
+    req.AppendLiteral("GET /gd/tlsa?host=");
+    req.Append(aHost);
+    req.AppendLiteral(" HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n");
+    if (PR_Send(fd, req.get(), req.Length(), 0, to) == (int32_t)req.Length()) {
+      nsAutoCString resp;
+      char buf[1024];
+      int32_t n;
+      while (resp.Length() < 16384 &&
+             (n = PR_Recv(fd, buf, sizeof buf, 0, to)) > 0) {
+        resp.Append(buf, n);
+      }
+      int32_t b = resp.Find("\r\n\r\n");
+      if (StringBeginsWith(resp, "HTTP/1.1 200"_ns) && b > 0) {
+        aBody.Assign(Substring(resp, b + 4));
+        ok = true;
+      }
+    }
+  }
+  PR_Close(fd);
+  return ok;
+}
+
+// The node emits flat JSON; pull one string or number field out of it.
+static nsAutoCString GreatDANEField(const nsACString& aJson, const char* aKey) {
+  nsAutoCString key;
+  key.AppendLiteral("\"");
+  key.Append(aKey);
+  key.AppendLiteral("\":");
+  nsAutoCString out;
+  int32_t i = aJson.Find(key);
+  if (i < 0) return out;
+  i += key.Length();
+  int32_t len = aJson.Length();
+  bool quoted = i < len && aJson[i] == '"';
+  if (quoted) i++;
+  while (i < len) {
+    char ch = aJson[i++];
+    if (quoted ? ch == '"' : (ch == ',' || ch == '}' || ch == ']')) break;
+    out.Append(ch);
+  }
+  return out;
+}
+
+static GreatDANEVerdict GreatDANEVerify(const nsACString& aHost,
+                                        const nsTArray<uint8_t>& aLeaf) {
+  nsAutoCString endpoint;
+  if (!GreatDANEEndpointFor(aHost, endpoint)) return GreatDANEVerdict::NotChain;
+  nsAutoCString body;
+  if (endpoint.IsEmpty() || !GreatDANEFetch(endpoint, aHost, body)) {
+    return GreatDANEVerdict::Fail;
+  }
+  if (!GreatDANEField(body, "status").EqualsLiteral("ok") ||
+      !GreatDANEField(body, "usage").EqualsLiteral("3") ||
+      !GreatDANEField(body, "selector").EqualsLiteral("1") ||
+      !GreatDANEField(body, "mtype").EqualsLiteral("1")) {
+    return GreatDANEVerdict::Fail;
+  }
+  nsAutoCString want = GreatDANEField(body, "data");
+  ToLowerCase(want);
+  if (want.Length() != 64) return GreatDANEVerdict::Fail;
+
+  Input leafInput;
+  if (leafInput.Init(aLeaf.Elements(), aLeaf.Length()) != Success) {
+    return GreatDANEVerdict::Fail;
+  }
+  BackCert leaf(leafInput, EndEntityOrCA::MustBeEndEntity, nullptr);
+  if (leaf.Init() != Success) return GreatDANEVerdict::Fail;
+  Input spki = leaf.GetSubjectPublicKeyInfo();
+  uint8_t digest[32];
+  if (PK11_HashBuf(SEC_OID_SHA256, digest, spki.UnsafeGetData(),
+                   spki.GetLength()) != SECSuccess) {
+    return GreatDANEVerdict::Fail;
+  }
+  static const char hex[] = "0123456789abcdef";
+  nsAutoCString got;
+  for (uint8_t b : digest) {
+    got.Append(hex[b >> 4]);
+    got.Append(hex[b & 15]);
+  }
+  return got.Equals(want) ? GreatDANEVerdict::Match : GreatDANEVerdict::Fail;
+}
+
 NS_IMETHODIMP
 SSLServerCertVerificationJob::Run() {
   // Runs on a cert verification thread and only on parent process.
@@ -792,6 +936,33 @@ SSLServerCertVerificationJob::Run() {
     return NS_ERROR_FAILURE;
