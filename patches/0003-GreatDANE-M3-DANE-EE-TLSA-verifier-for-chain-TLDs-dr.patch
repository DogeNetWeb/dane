+      if (v == GreatDANEVerdict::Match) {
+        builtChain.AppendElement(mPeerCertChain.ElementAt(0).Clone());
+      }
+      bool ok = v == GreatDANEVerdict::Match;
+      nsresult rv = mResultTask->Dispatch(
+          std::move(builtChain), std::move(mPeerCertChain),
+          nsITransportSecurityInfo::CERTIFICATE_TRANSPARENCY_NOT_APPLICABLE,
+          EVStatus::NotEV, ok,
+          ok ? 0 : (PRErrorCode)MOZILLA_PKIX_ERROR_KEY_PINNING_FAILURE,
+          nsITransportSecurityInfo::OverridableErrorCategory::ERROR_UNSET,
+          false, mProviderFlags, false);
+      if (NS_FAILED(rv)) {
+        mResultTask.forget().leak();
+      }
+      return rv;
+    }
+  }
