+
+## Grokipedia: why a letter tile (round 3, 2026-11-10)
+The coordinator ruled that xAI's Grokipedia mark must not be bundled, so the round-2 favicon-derived files
+(`images/grokipedia-com@2x.png`, `favicons/grokipedia-com.png`) were removed. Without some tippytop entry, the
+new-tab page would capture a screenshot of grokipedia.com for its default tile. The narrowest mechanism that
+avoids that, without touching any pref or turning screenshots off globally, is to keep the exact-host tippytop
+entry and point it at our own neutral letter tile. The tile only identifies the site by its initial, the same
+way a generic letter fallback does.
diff --git a/greatdane/tools/make_letter_tile.py b/greatdane/tools/make_letter_tile.py
new file mode 100644
index 0000000000..2bd7d39b69
--- /dev/null
+++ b/greatdane/tools/make_letter_tile.py
@@ -0,0 +1,14 @@
+#!/usr/bin/env python3
+# Usage: make_letter_tile.py <images/...@2x.png 192px> <favicons/....png 32px>   (needs Pillow + DejaVu Sans Bold)
+# Generates the neutral letter tile used for the grokipedia.com default tile (not the site's own mark).
+from PIL import Image, ImageDraw, ImageFont
+import sys
+BG, FG = (74, 85, 104, 255), (255, 255, 255, 255)   # #4a5568 slate, white
+FONT = "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf"
+def tile(n, out):
+    im = Image.new("RGBA", (n, n), BG); d = ImageDraw.Draw(im)
+    f = ImageFont.truetype(FONT, int(n * 0.62))
+    l, t, r, b = d.textbbox((0, 0), "G", font=f)
+    d.text(((n - (r - l)) / 2 - l, (n - (b - t)) / 2 - t), "G", font=f, fill=FG)
+    im.save(out, optimize=True)
+tile(192, sys.argv[1]); tile(32, sys.argv[2])
