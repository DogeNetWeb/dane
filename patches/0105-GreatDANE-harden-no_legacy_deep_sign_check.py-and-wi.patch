+    print("legacy-signing check: %s (%d hit%s, %d waived, %d files)" % (
+        "FAIL" if hits else "PASS", len(hits), "" if len(hits) == 1 else "s", len(waived), len(files)))
+    sys.exit(1 if hits else 0)
+
+
+if __name__ == "__main__":
+    main()
