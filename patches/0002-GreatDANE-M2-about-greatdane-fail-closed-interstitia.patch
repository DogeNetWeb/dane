         }
       }
       let { exitCode } = await c.proc.wait();
@@ -102,12 +111,46 @@ export const GreatDANE = {
       log(c.coin, "node failure", e);
     }
     c.ports = null;
+    c.status = null;
     c.state = "down";
+    c.lastExit = Date.now();
     if (this._quitting) return;
