+++ b/browser/components/urlbar/UrlbarProviderSearchSuggestions.sys.mjs
@@ -192,6 +192,21 @@ export class UrlbarProviderSearchSuggestions extends UrlbarProvider {
       return false;
     }
 
+    // GreatDANE: never send a chain name (e.g. "foo.pepe") to a search
+    // engine's suggestion endpoint, even if the user re-enabled suggestions.
+    let gdTlds = Services.prefs
+      .getStringPref("greatdane.chains", "")
+      .split(",")
+      .map(spec => spec.split(":")[1]?.trim())
+      .filter(Boolean);
+    for (let s of [searchString, queryContext.searchString]) {
+      for (let tld of gdTlds) {
+        if (new RegExp("\\." + tld + "\\.?(?:[:/?#\\s]|$)", "i").test(s || "")) {
+          return false;
+        }
+      }
+    }
+
     // Allow remote suggestions if trending suggestions are enabled.
     if (this.#shouldFetchTrending(queryContext)) {
       return true;
