       for (let c of this._chains.values()) {
@@ -78,22 +92,17 @@ export const GreatDANE = {
       });
       this._drainStderr(c.proc);
       let buf = "";
-      while (!c.ports) {
+      for (;;) {
         let s = await c.proc.stdout.readString();
-        if (!s) throw new Error("node exited before ready");
