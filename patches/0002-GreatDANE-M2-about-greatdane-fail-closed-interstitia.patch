+        let nl;
+        while ((nl = buf.indexOf("\n")) >= 0) {
+          let line = buf.slice(0, nl);
+          buf = buf.slice(nl + 1);
+          let msg;
+          try { msg = JSON.parse(line); } catch (e) { continue; }
