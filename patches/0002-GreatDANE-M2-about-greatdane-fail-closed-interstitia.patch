     setTimeout(() => this._spawn(c), delay);
   },
 
+  async _onNodeMsg(c, msg) {
+    if (msg.event == "ready" && msg.tld == c.tld) {
+      if (Services.prefs.getBoolPref(PREF + "dev.mintedCA", false)) {
+        await this._importDevCA(msg.ca);
+      }
+      c.ports = { pac: msg.pac, dns: msg.dns, proxy: msg.proxy, pf: msg.pf };
+      c.state = "ready";
+      c.restarts = 0;
+      c.since = Date.now();
+      log(c.coin, "ready", JSON.stringify(c.ports));
+    } else if (msg.event == "status" && msg.coin == c.coin) {
+      c.status = msg;
+    }
+  },
+
+  // Synced = the node finished at least one pass and is not behind what its
+  // peers advertise. Until then chain names are not resolvable, by design.
+  _synced(c) {
+    let st = c.status;
+    if (c.state != "ready" || !st || st.passes < 1) return false;
+    // An empty or stale chain is never "synced", even with no peers to ask.
+    if (!st.height || st.height < (st.activation || 0)) return false;
+    return !st.peer_height || st.height + 2 >= st.peer_height;
+  },
+
+  // What a navigation to a chain host would hit right now, or null if open.
+  blockReason(c) {
+    if (c.state != "ready") return "GD_NODE_NOT_READY";
+    if (!this._synced(c)) return "GD_NODE_SYNCING";
+    return null;
+  },
+
   async _drainStderr(proc) {
     try {
       let s;
@@ -147,7 +190,8 @@ export const GreatDANE = {
       cb.onProxyFilterResult(proxyInfo);
       return;
     }
-    let port = c.state == "ready" ? c.ports.pac : DEAD_PORT;
+    // Fail closed: not ready or still syncing -> dead proxy, never DIRECT.
+    let port = this.blockReason(c) ? DEAD_PORT : c.ports.pac;
     cb.onProxyFilterResult(
       pps.newProxyInfo("http", "127.0.0.1", port, "", "", 0, 0xffffffff, null)
     );
diff --git a/browser/components/greatdane/GreatDANEAbout.sys.mjs b/browser/components/greatdane/GreatDANEAbout.sys.mjs
new file mode 100644
index 0000000000..eca093ae9d
--- /dev/null
+++ b/browser/components/greatdane/GreatDANEAbout.sys.mjs
@@ -0,0 +1,133 @@
+/* GreatDANE: about:greatdane (status + fail-closed interstitials) and the
+ * tab trap that swaps any Firefox error page for a chain host to ours.
+ * The page is generated in the parent, has no script and no override
+ * button; it meta-refreshes and auto-continues once the chain is usable. */
+
+import { GreatDANE } from "resource:///modules/GreatDANE.sys.mjs";
+
+const CID = Components.ID("{6d1b6f0e-5a7e-4f43-9e64-2f1c3c0de6a1}");
+const CONTRACT = "@mozilla.org/network/protocol/about;1?what=greatdane";
+
+const ERRORS = {
+  GD_NODE_NOT_READY: ["The PepeNet node is not running yet",
+    "GreatDANE resolves chain names with its own built-in node. It is starting (or restarting after a crash). This page will continue on its own when the node is up."],
+  GD_NODE_SYNCING: ["Still syncing the chain",
+    "Names are only trusted once the node has caught up with the network, so nothing for this site is loaded until then. This page will continue on its own when sync finishes."],
+  GD_TLS_UNTRUSTED: ["Could not verify this site's key",
+    "The connection did not verify against the key published on chain. GreatDANE will not let you continue to an unverified chain site."],
+  GD_SITE_UNREACHABLE: ["Site unreachable",
+    "The name is on the chain but its server could not be reached through the node."],
+};
+
+const esc = s => String(s ?? "").replace(/[&<>"']/g, ch => "&#" + ch.charCodeAt(0) + ";");
+
+function safeTarget(u) {
+  try {
+    let uri = Services.io.newURI(u);
+    if ((uri.scheme == "https" || uri.scheme == "http") && GreatDANE._chainFor(uri.host)) {
+      return uri.spec;
+    }
+  } catch (e) {}
+  return null;
+}
+
+function chainRows() {
+  let rows = "";
+  for (let c of GreatDANE._chains.values()) {
+    let st = c.status || {};
+    let state = c.state == "ready" ? (GreatDANE._synced(c) ? "ready" : "syncing") : c.state;
+    let up = c.since && c.state == "ready" ? Math.round((Date.now() - c.since) / 1000) + " s" : "-";
+    rows += `<tr><td>.${esc(c.tld)} (${esc(c.coin)})</td><td class="${esc(state)}">${esc(state)}</td>
+      <td>${esc(st.height ?? "-")}</td><td>${esc(st.peer_height || "-")}</td>
+      <td>${esc(st.peers_pepenet ?? "-")} / ${esc(st.peers_known ?? "-")}</td>
+      <td>${esc(st.passes ?? "-")}</td><td>${esc(st.dane_ok ?? "-")} / ${esc(st.dane_fail ?? "-")}</td>
+      <td>${c.ports ? esc(c.ports.pac) : "-"}</td><td>${up}</td><td>${esc(c.restarts)}</td></tr>`;
+  }
+  return rows;
+}
+
+function render(uri) {
+  let q = new URLSearchParams(uri.query || "");
+  let code = q.get("e");
+  let target = safeTarget(q.get("u") || "");
+  let refresh = 3;
+  let head = "";
+  if (code && target) {
+    let c = GreatDANE._chainFor(Services.io.newURI(target).host);
+    let now = c && GreatDANE.blockReason(c);
+    if ((code == "GD_NODE_NOT_READY" || code == "GD_NODE_SYNCING") && c && !now) {
+      // cleared: continue to the site
+      head = `<meta http-equiv="refresh" content="0;url=${esc(target)}">`;
+    } else {
+      if (now) code = now; // e.g. not-ready became syncing
+      if (!ERRORS[code]) code = "GD_SITE_UNREACHABLE";
+    }
+  }
+  if (!head) head = `<meta http-equiv="refresh" content="${refresh}">`;
+  let err = code && ERRORS[code];
+  let box = err ? `<div class="err"><h1>${esc(err[0])}</h1><p>${esc(err[1])}</p>
+      <p class="u">${esc(target || "")}</p><p class="code">${esc(code)}</p></div>` :
+    `<h1>GreatDANE</h1>`;
+  return `<!DOCTYPE html><html><head><meta charset="utf-8">${head}
+<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
+<title>${err ? esc(err[0]) : "GreatDANE status"}</title><style>
+body{font:15px system-ui,sans-serif;background:#0f1a12;color:#e6efe8;margin:40px auto;max-width:900px}
+.err{border-left:4px solid #e0a030;padding:4px 20px;margin-bottom:30px}
+.u{font-family:monospace;color:#9fc}.code{color:#888;font-size:12px}
+table{border-collapse:collapse;width:100%}td,th{padding:6px 8px;border-bottom:1px solid #2a3a2e;text-align:left}
+.ready{color:#6f6}.syncing{color:#fc4}.starting,.down{color:#f66}</style></head><body>
+${box}<h2>Chains</h2><table><tr><th>Chain</th><th>Node</th><th>Height</th><th>Peer height</th>
+<th>PepeNet / known peers</th><th>Passes</th><th>DANE ok / fail</th><th>Port</th><th>Up</th><th>Restarts</th></tr>
+${chainRows()}</table><p class="code">Updates every ${refresh} s.</p></body></html>`;
+}
+
+const AboutGreatDANE = {
+  newChannel(uri, loadInfo) {
+    let stream = Cc["@mozilla.org/io/string-input-stream;1"].createInstance(Ci.nsIStringInputStream);
+    stream.setUTF8Data(render(uri));
+    let isc = Cc["@mozilla.org/network/input-stream-channel;1"].createInstance(Ci.nsIInputStreamChannel);
+    isc.setURI(uri);
+    isc.contentStream = stream;
+    let ch = isc.QueryInterface(Ci.nsIChannel);
+    ch.contentType = "text/html";
+    ch.contentCharset = "UTF-8";
+    ch.loadInfo = loadInfo;
+    ch.originalURI = uri;
+    return ch;
+  },
+  getURIFlags() { return Ci.nsIAboutModule.HIDE_FROM_ABOUTABOUT; },
+  getChromeURI(uri) { return uri; },
+  QueryInterface: ChromeUtils.generateQI(["nsIAboutModule"]),
+};
+
+export function registerAbout() {
+  let reg = Components.manager.QueryInterface(Ci.nsIComponentRegistrar);
+  if (reg.isCIDRegistered(CID)) return;
+  reg.registerFactory(CID, "about:greatdane", CONTRACT, {
+    createInstance(iid) { return AboutGreatDANE.QueryInterface(iid); },
+    QueryInterface: ChromeUtils.generateQI(["nsIFactory"]),
+  });
+}
+
+// Any Firefox error page for a chain host (proxy refused, cert error, net
+// error) is replaced by ours: no "Accept the risk", no "try again" bypass.
+export const ErrorTrap = {
+  onLocationChange(browser, webProgress, request, location, flags) {
+    if (!webProgress.isTopLevel || !(flags & Ci.nsIWebProgressListener.LOCATION_CHANGE_ERROR_PAGE)) return;
+    let c = null;
+    try { c = GreatDANE._chainFor(location.host); } catch (e) { return; }
+    if (!c) return;
+    let code = GreatDANE.blockReason(c);
+    if (!code) {
+      let status = 0;
+      try { status = request?.QueryInterface(Ci.nsIChannel).status; } catch (e) {}
+      let mod = ((status >>> 16) & 0x7fff) - 0x45;
+      code = mod == 21 ? "GD_TLS_UNTRUSTED" : "GD_SITE_UNREACHABLE";
+    }
+    let u = "about:greatdane?e=" + code + "&u=" + encodeURIComponent(location.spec);
+    browser.loadURI(Services.io.newURI(u), {
+      triggeringPrincipal: Services.scriptSecurityManager.getSystemPrincipal(),
+      loadFlags: Ci.nsIWebNavigation.LOAD_FLAGS_REPLACE_HISTORY,
+    });
+  },
+};
