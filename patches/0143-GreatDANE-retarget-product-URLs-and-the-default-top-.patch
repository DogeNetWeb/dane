diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
index 30afcd503a..487de0bf3b 100644
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -3703,7 +3703,7 @@ pref("browser.urlbar.suggest.quicksuggest.sponsored", false);
 // for facebook/reddit/wikipedia/twitter. Region-independent — remote/region
 // top-sites lists would otherwise override default.sites.
 pref("browser.topsites.useRemoteSetting", false);
-pref("browser.newtabpage.activity-stream.default.sites", "https://www.youtube.com/,https://pepecoin.surf/,https://www.amazon.com/,https://dogecoin.surf/,https://grokipedia.com/,https://x.com/,https://greatdane.doge/");
+pref("browser.newtabpage.activity-stream.default.sites", "https://www.youtube.com/,https://dane.surf/,https://www.amazon.com/,https://grokipedia.com/,https://x.com/,https://greatdane.doge/");
 // Startup + Home button: the new-tab page with the tiles (no forced site homepage).
 pref("browser.startup.page", 1);
 pref("browser.startup.homepage", "about:home");
@@ -3716,7 +3716,7 @@ pref("browser.newtabpage.activity-stream.enabled", true);
 // (../updates/embed-mar-cert.sh); the distribution policy keeps
 // DisableAppUpdate until that step and --enable-update-channel=esr land.
 pref("app.update.auto", true);
-pref("app.update.url", "https://pepecoin.surf/dane/update/3/%PRODUCT%/%VERSION%/%BUILD_ID%/%BUILD_TARGET%/%LOCALE%/%CHANNEL%/update.xml");
+pref("app.update.url", "https://dane.surf/update/3/%PRODUCT%/%VERSION%/%BUILD_ID%/%BUILD_TARGET%/%LOCALE%/%CHANNEL%/update.xml");
 pref("browser.fixup.domainsuffixwhitelist.pepe", true);
 // Search suggestions are stock (on); a typed chain name with its suffix is
 // never sent (UrlbarProviderSearchSuggestions guard). Registered .pepe/.doge
diff --git a/browser/branding/greatdane/pref/firefox-branding.js b/browser/branding/greatdane/pref/firefox-branding.js
index c6e2a001c0..02b30e42a2 100644
--- a/browser/branding/greatdane/pref/firefox-branding.js
+++ b/browser/branding/greatdane/pref/firefox-branding.js
@@ -13,10 +13,10 @@ pref("app.update.interval", 86400); // 24 hours
 pref("app.update.promptWaitTime", 86400);
 // URL user can browse to manually if for some reason all update installation
 // attempts fail.
-pref("app.update.url.manual", "https://pepecoin.surf/dane/download/");
+pref("app.update.url.manual", "https://dane.surf/download/");
 // A default value for the "More information about this update" link
 // supplied in the "An update is available" page of the update wizard.
-pref("app.update.url.details", "https://pepecoin.surf/dane/releases/");
+pref("app.update.url.details", "https://dane.surf/releases/");
 
 // The number of days a binary is permitted to be old
 // without checking for an update.  This assumes that
