 .err{border-left:4px solid #e0a030;padding:4px 20px;margin-bottom:30px}
-.u{font-family:monospace;color:light-dark(#2a5bb8,#9cc4ff)}.code{color:#888;font-size:12px}
+a{color:light-dark(#2a5bb8,#9cc4ff)}.u{font-family:monospace;color:light-dark(#2a5bb8,#9cc4ff)}.code{color:#888;font-size:12px}
 table{border-collapse:collapse;width:100%}td,th{padding:6px 8px;border-bottom:1px solid var(--line);text-align:left}
 .ready{color:#6f6}.syncing{color:#fc4}.starting,.down{color:#f66}</style></head><body>
 ${box}<h2>Chains</h2><table><tr><th>Chain</th><th>Node</th><th>Height</th><th>Peer height</th>
diff --git a/browser/components/preferences/config/greatdane.mjs b/browser/components/preferences/config/greatdane.mjs
index 7da83cd5de..90cc1db55c 100644
--- a/browser/components/preferences/config/greatdane.mjs
+++ b/browser/components/preferences/config/greatdane.mjs
@@ -19,6 +19,8 @@ const CHAINS = [
 
 Preferences.addAll([
   ...CHAINS.map(c => ({ id: `greatdane.${c.coin}.enabled`, type: "bool" })),
+  ...CHAINS.map(c => ({ id: `greatdane.${c.coin}.listen`, type: "bool" })),
+  ...CHAINS.map(c => ({ id: `greatdane.${c.coin}.listen_port`, type: "int" })),
   { id: "greatdane.chainHostPattern", type: "string" },
   { id: "greatdane.update.skipFirstRunWindowSec", type: "int" },
 ]);
@@ -30,38 +32,64 @@ function chain(coin) {
   return null;
 }
 
-// Poll the node status (the node pushes status lines; no observer topic).
-function pollSetup(emitChange) {
-  let t = setInterval(emitChange, 2000);
-  return () => clearInterval(t);
+// The node pushes status lines (change-driven, 3 s heartbeat); re-render on
+// a 1 s timer. On open, ask each node for an immediate line.
+function pollSetup(coin) {
+  return emitChange => {
+    GreatDANE.requestStatus?.(chain(coin));
+    let t = setInterval(emitChange, 1000);
+    return () => clearInterval(t);
+  };
 }
 
 function statusArgs(coin, def) {
   let c = chain(coin);
   let st = c?.status || {};
-  let state = !c ? "off" : c.state == "ready" ? (GreatDANE._synced(c) ? "ready" : "syncing") : c.state;
-  let pct = "-";
-  if (st.height && st.peer_height) {
-    pct = Math.min(100, Math.floor((st.height / st.peer_height) * 1000) / 10) + "%";
-  } else if (c && GreatDANE._synced(c)) {
-    pct = "100%";
+  // Node state (starting/connecting/syncing/ready/stopped) once it reports;
+  // the browser-side state (off/starting/down) before that.
+  let state = !c ? "off" : c.state != "ready" ? c.state : typeof st.state == "string" ? st.state : "starting";
+  let pct = typeof st.sync_pct == "number" ? `${st.sync_pct.toFixed(1)}%` : "-";
+  let listen = st.listen ?? "-";
+  if (st.listen == "bind_failed") {
+    listen = `bind_failed${st.listen_error ? ` (${st.listen_error})` : ""}`;
   }
   return {
     state,
-    listen: st.listen ?? "-",
+    listen,
     port: Number.isInteger(st.listen_port) && st.listen_port > 0 ? String(st.listen_port) : `- (${def})`,
-    // TODO(node iface): node reports peers_pepenet / peers_known, not in/out.
-    peers: `${st.peers_pepenet ?? "-"} / ${st.peers_known ?? "-"}`,
+    peersIn: String(st.peers_in ?? "-"),
+    peersOut: String(st.peers_out ?? "-"),
     height: String(st.height ?? "-"),
     sync: pct,
+    dir: typeof st.data_dir == "string" ? st.data_dir : "-",
   };
 }
 
 for (let c of CHAINS) {
   Preferences.addSetting({ id: `gd-${c.coin}-enabled`, pref: `greatdane.${c.coin}.enabled` });
+  Preferences.addSetting({ id: `gd-${c.coin}-listen`, pref: `greatdane.${c.coin}.listen` });
+  Preferences.addSetting({
+    id: `gd-${c.coin}-listen-port`,
+    pref: `greatdane.${c.coin}.listen_port`,
+    deps: [`gd-${c.coin}-listen`],
+    disabled: deps => !deps[`gd-${c.coin}-listen`].value,
+    get: v => String(v ?? c.port),
+    // Reject 0, junk and out-of-range: keep the current pref.
+    set: (v, deps, setting) => {
+      let n = /^\d{1,5}$/.test(String(v).trim()) ? Number(v) : 0;
+      return n >= 1 && n <= 65535 ? n : setting.pref.value;
+    },
+    setup: pollSetup(c.coin),
+    getControlConfig(config) {
+      let st = chain(c.coin)?.status || {};
+      let err = st.listen == "bind_failed"
+        ? `bind_failed: ${st.listen_error || "errno " + (st.listen_errno ?? "?")}` : "";
+      return { ...config, l10nArgs: { err } };
+    },
+  });
   Preferences.addSetting({
     id: `gd-${c.coin}-status`,
-    setup: pollSetup,
+    setup: pollSetup(c.coin),
     getControlConfig(config) {
       return { ...config, l10nArgs: statusArgs(c.coin, c.port) };
     },
@@ -77,6 +105,7 @@ Preferences.addSetting({
   },
 });
 Preferences.addSetting({ id: "gd-chain-host-pattern", pref: "greatdane.chainHostPattern" });
+Preferences.addSetting({ id: "gd-discover-link" });
 Preferences.addSetting({
   id: "gd-update-channel",
   getControlConfig(config) {
@@ -109,9 +138,19 @@ SettingGroupManager.registerGroups({
           control: "moz-box-item",
           controlAttrs: { id: `gd-${c.coin}-status` },
         },
+        {
+          id: `gd-${c.coin}-listen`,
+          l10nId: "greatdane-chain-listen",
+          control: "moz-toggle",
+          controlAttrs: { id: `gd-${c.coin}-listen` },
+        },
+        {
+          id: `gd-${c.coin}-listen-port`,
+          l10nId: "greatdane-chain-listen-port",
+          control: "moz-input-text",
+          controlAttrs: { id: `gd-${c.coin}-listen-port`, inputmode: "numeric" },
+        },
       ]),
-      // TODO(node iface): greatdane.<chain>.listen / .port / .maxInbound /
-      // .maxOutbound toggles once greatdane-node takes those flags.
       {
         id: "gd-data-dir",
         l10nId: "greatdane-data-dir",
@@ -130,6 +169,12 @@ SettingGroupManager.registerGroups({
         control: "moz-input-text",
         controlAttrs: { id: "gd-chain-host-pattern" },
       },
+      {
+        id: "gd-discover-link",
+        l10nId: "greatdane-discover-link",
+        control: "moz-box-link",
+        controlAttrs: { id: "gd-discover-link", href: "about:dane-discover" },
+      },
     ],
   },
   greatdaneUpdates: {
