From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nowon <nowon@noreply.pepecoin.surf>
Date: Mon, 26 Oct 2026 15:56:15 -0500
Subject: [PATCH 029/144] GreatDANE: node listen controls + status events in
 the Dane pane

--no-listen / --listen-port per chain (greatdane.{pep,doge}.listen, listen_port),
restart on change, {"cmd":"status"} polling; pane shows state, sync %, peers in/out,
data dir and bind_failed errors. Max-peer controls removed (node has no such flag).
---
 browser/app/profile/firefox.js                |  4 +
 .../components/greatdane/GreatDANE.sys.mjs    | 46 +++++++++--
 .../greatdane/GreatDANEAbout.sys.mjs          |  4 +-
 .../preferences/config/greatdane.mjs          | 77 +++++++++++++++----
 .../en-US/browser/preferences/greatdane.ftl   | 14 +++-
 5 files changed, 119 insertions(+), 26 deletions(-)

diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
index 6c8b9a58f1..a11558d6d1 100644
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -3642,6 +3642,10 @@ pref("greatdane.node.dataDir", "");
 // Per-chain node on/off (Dane settings pane). Off = that TLD fails closed.
 pref("greatdane.pep.enabled", true);
 pref("greatdane.doge.enabled", true);
+pref("greatdane.pep.listen", true);
+pref("greatdane.doge.listen", true);
+pref("greatdane.pep.listen_port", 33874);
+pref("greatdane.doge.listen_port", 22556);
 // Hide Firefox Account/Sync in Settings (off: Dane is Firefox minus nothing).
 pref("greatdane.prefs.hideSync", false);
 // Fallback chain-host test (RegExp source, case-insensitive) used only when
diff --git a/browser/components/greatdane/GreatDANE.sys.mjs b/browser/components/greatdane/GreatDANE.sys.mjs
index 1896bdc9a6..32778be6a7 100644
--- a/browser/components/greatdane/GreatDANE.sys.mjs
+++ b/browser/components/greatdane/GreatDANE.sys.mjs
@@ -55,13 +55,39 @@ export const GreatDANE = {
   },
 
   // greatdane.<coin>.enabled (default true): run that chain's node.
-  // TODO(node settings iface): greatdane.<coin>.listen / .port / .maxInbound /
-  // .maxOutbound once greatdane-node accepts them (it only takes --only/--data
-  // /--ephemeral-ports/--dane-api/--stdio today).
+  // greatdane.<coin>.listen (default true) and .listen_port (1..65535) map to
+  // --no-listen / --listen-port N at spawn (NODE-SETTINGS-IFACE §2). Peer caps
+  // are compile-time in the node and deliberately not exposed.
   _chainEnabled(coin) {
     return Services.prefs.getBoolPref(PREF + coin + ".enabled", true);
   },
 
+  _listenArgs(coin) {
+    if (!Services.prefs.getBoolPref(PREF + coin + ".listen", true)) {
+      return ["--no-listen"];
+    }
+    let p = Services.prefs.getIntPref(PREF + coin + ".listen_port", 0);
+    // 0/out of range: no flag, the node uses the chain default port.
+    return Number.isInteger(p) && p >= 1 && p <= 65535 ? ["--listen-port", String(p)] : [];
+  },
+
+  // Settings apply at spawn: stop the child; _spawn's exit path respawns it
+  // at once (no backoff) with the new flags.
+  restartChain(c) {
+    if (c.off || this._quitting) return;
+    log(c.coin, "settings changed; restarting node");
+    c.restarts = 0;
+    if (c.proc) {
+      c.respawnNow = true;
+      try { c.proc.stdin.close(); } catch (e) {}
+    }
+  },
+
+  // Ask the node for an immediate status line (stdin query, iface §3).
+  requestStatus(c) {
+    try { c?.proc?.stdin.write('{"cmd":"status"}\n'); } catch (e) {}
+  },
+
   setChainEnabled(c, on) {
     if (on == !c.off) return;
     c.off = !on;
@@ -77,9 +103,11 @@ export const GreatDANE = {
 
   observe(subject, topic, data) {
     if (topic == "nsPref:changed") {
-      let m = /^greatdane\.([a-z]+)\.enabled$/.exec(data);
+      let m = /^greatdane\.([a-z]+)\.(enabled|listen|listen_port)$/.exec(data);
       let c = m && [...this._chains.values()].find(x => x.coin == m[1]);
-      if (c) this.setChainEnabled(c, this._chainEnabled(c.coin));
+      if (!c) return;
+      if (m[2] == "enabled") this.setChainEnabled(c, this._chainEnabled(c.coin));
+      else this.restartChain(c);
       return;
     }
     if (topic == "browser-delayed-startup-finished") {
@@ -174,7 +202,8 @@ export const GreatDANE = {
     try {
       c.proc = await Subprocess.call({
         command: this._nodePath(),
-        arguments: ["--data", this._dataDir(), "--only", c.coin, "--ephemeral-ports", "--dane-api", "--stdio"],
+        arguments: ["--data", this._dataDir(), "--only", c.coin, "--ephemeral-ports", "--dane-api", "--stdio",
+                    ...this._listenArgs(c.coin)],
         stdin: "pipe",
         stdout: "pipe",
         stderr: "pipe",
@@ -207,6 +236,11 @@ export const GreatDANE = {
     c.proc = null;
     if (c.off) { c.state = "off"; return; }
     if (this._quitting) return;
+    if (c.respawnNow) {
+      c.respawnNow = false;
+      this._spawn(c);
+      return;
+    }
     let delay = Math.min(30000, 500 * 2 ** c.restarts++);
     setTimeout(() => this._spawn(c), delay);
   },
