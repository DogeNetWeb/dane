 <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src chrome:">
@@ -140,7 +140,7 @@ body{font:15px system-ui,sans-serif;background:var(--bg);color:var(--fg);margin:
 .dane{display:block;width:180px;margin:0 auto 10px;-moz-context-properties:fill;fill:var(--dane)}
