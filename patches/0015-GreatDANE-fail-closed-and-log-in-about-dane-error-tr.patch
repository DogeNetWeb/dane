+    let tlsFail = mod == 21 || (doc !== null && /^about:certerror|[?&]e=nss/.test(doc))
+      ? true : (doc === null || !statusKnown ? null : false);
     let go = code => {
       let u = "about:dane?e=" + code + "&u=" + encodeURIComponent(location.spec);
       browser.loadURI(Services.io.newURI(u), {
@@ -153,13 +195,12 @@ export const ErrorTrap = {
       });
     };
     if (code) { go(code); return; }
-    GreatDANE.tlsaStatus(location.host).then(st => {
-      if (st === null) go("GD_NODE_NOT_READY");
-      else if (st == "unowned" || st == "bad_name") go("GD_NAME_UNOWNED");
-      else if (st == "no_tlsa") go("GD_NO_TLSA");
-      else if (st == "bad_record") go("GD_BAD_TLSA");
-      else go(tlsFail ? "GD_TLS_UNTRUSTED" : "GD_SITE_UNREACHABLE");
