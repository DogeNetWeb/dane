diff --git a/browser/components/greatdane/test/unit/test_greatdane_failclosed.js b/browser/components/greatdane/test/unit/test_greatdane_failclosed.js
new file mode 100644
index 0000000000..05d6383847
--- /dev/null
+++ b/browser/components/greatdane/test/unit/test_greatdane_failclosed.js
@@ -0,0 +1,125 @@
+/* Any copyright is dedicated to the Public Domain.
+ * http://creativecommons.org/publicdomain/zero/1.0/ */
+
+// .doge/.pepe loads must fail closed and land on the right Dane interstitial
+// for: no TLSA record, TLSA/cert mismatch, node unreachable. The node's
+// /gd/tlsa API is mocked; no real node is started.
+
+"use strict";
+
+const { GreatDANE } = ChromeUtils.importESModule("resource:///modules/GreatDANE.sys.mjs");
+const { ErrorTrap, _render, classifyChainFailure } = ChromeUtils.importESModule(
+  "resource:///modules/GreatDANEAbout.sys.mjs"
+);
+
+const MOCK = { "notlsa.doge": "no_tlsa", "mismatch.doge": "ok", "notlsa.pepe": "no_tlsa" };
+let mockPort = globalThis.GD_MOCK_PORT; // set by an external runner with its own mock
+let server = null;
+
+function startMock() {
+  if (mockPort) return;
+  const { HttpServer } = ChromeUtils.importESModule("resource://testing-common/httpd.sys.mjs");
+  server = new HttpServer();
+  server.registerPathHandler("/gd/tlsa", (req, resp) => {
+    let host = new URLSearchParams(req.queryString).get("host");
+    resp.setHeader("Content-Type", "application/json", false);
+    resp.write(JSON.stringify({ status: MOCK[host] || "unowned" }));
+  });
+  server.start(-1);
+  mockPort = server.identity.primaryPort;
+}
+
+const saved = new Map(GreatDANE._chains);
+function chain(tld, over = {}) {
+  return Object.assign({
+    tld, coin: tld, state: "ready", restarts: 0, since: Date.now(),
+    status: { height: 100, activation: 1, peer_height: 100, passes: 1 },
+    ports: { pac: mockPort },
+  }, over);
+}
+function setChains(...cs) {
+  GreatDANE._chains.clear();
+  for (let c of cs) GreatDANE._chains.set(c.tld, c);
+}
+
+// Drive the tab trap for a failed top-level load; return the interstitial code.
+async function trap(url, { doc = "about:neterror?e=proxyConnectFailure", docThrows = false } = {}) {
+  let loaded = null;
+  let browser = {
+    get documentURI() {
+      if (docThrows) throw new Error("dead browser");
+      return Services.io.newURI(doc);
+    },
+    loadURI(u) { loaded = u.spec; },
+  };
+  await ErrorTrap.onLocationChange(
+    browser, { isTopLevel: true }, null, Services.io.newURI(url),
+    Ci.nsIWebProgressListener.LOCATION_CHANGE_ERROR_PAGE
+  );
+  Assert.ok(loaded, "error page for " + url + " was replaced");
+  let u = new URL(loaded);
+  Assert.equal(u.protocol + u.pathname, "about:dane", "goes to about:dane");
+  Assert.equal(u.searchParams.get("u"), url, "keeps the target only as text");
+  return { code: u.searchParams.get("e"), html: _render(Services.io.newURI(loaded)) };
+}
+
+function assertBlocked(html, code, heading) {
+  Assert.ok(html.includes(heading), "interstitial says: " + heading);
+  Assert.ok(html.includes(code), "shows code " + code);
+  Assert.ok(!/content="0;url=/.test(html), "no auto-continue to the site");
+  Assert.ok(!/<a\b|<button|<script/i.test(html), "no override link/button/script");
+}
+
+add_setup(() => {
+  startMock();
+  registerCleanupFunction(() => {
+    GreatDANE._chains.clear();
+    for (let [k, v] of saved) GreatDANE._chains.set(k, v);
+    return server && new Promise(r => server.stop(r));
+  });
+});
+
+add_task(async function no_tlsa_record() {
+  setChains(chain("doge"), chain("pepe"));
+  for (let url of ["https://notlsa.doge/", "https://notlsa.pepe/"]) {
+    let { code, html } = await trap(url);
+    Assert.equal(code, "GD_NO_TLSA", url);
+    assertBlocked(html, "GD_NO_TLSA", "This site has not published a key");
+  }
+});
+
+add_task(async function tlsa_cert_mismatch() {
+  setChains(chain("doge"));
+  let { code, html } = await trap("https://mismatch.doge/", { doc: "about:certerror?e=nssFailure2&u=x" });
+  Assert.equal(code, "GD_TLS_UNTRUSTED");
+  assertBlocked(html, "GD_TLS_UNTRUSTED", "does not match the chain");
+  // Failure kind unknown (error page unreadable): still the mismatch page.
+  ({ code } = await trap("https://mismatch.doge/", { docThrows: true }));
+  Assert.equal(code, "GD_TLS_UNTRUSTED", "unknown failure kind fails closed");
+});
+
+add_task(async function node_unreachable() {
+  // Node process down.
+  setChains(chain("doge", { state: "down", ports: null }));
+  let { code, html } = await trap("https://notlsa.doge/");
+  Assert.equal(code, "GD_NODE_NOT_READY");
+  assertBlocked(html, "GD_NODE_NOT_READY", "PepeNet node is not running");
+  // Node "ready" but its API does not answer (closed port).
+  setChains(chain("doge", { ports: { pac: 9 } }));
+  ({ code } = await trap("https://mismatch.doge/"));
+  Assert.equal(code, "GD_NODE_NOT_READY", "unanswerable node fails closed");
+  // The proxy filter never goes DIRECT for a down chain.
+  setChains(chain("doge", { state: "down", ports: null }));
+  let pi = await new Promise(r => GreatDANE.applyFilter(
+    Services.io.newURI("https://x.doge/"), null, { onProxyFilterResult: r }));
+  Assert.equal(pi.host, "127.0.0.1");
+  Assert.equal(pi.port, 9, "dead proxy port, never DIRECT");
+});
+
+add_task(function classify_unknowns_fail_closed() {
+  Assert.equal(classifyChainFailure({}), "GD_NODE_NOT_READY");
+  Assert.equal(classifyChainFailure({ tlsa: "ok" }), "GD_TLS_UNTRUSTED");
+  Assert.equal(classifyChainFailure({ tlsa: "ok", tlsFail: false }), "GD_SITE_UNREACHABLE");
+  Assert.equal(classifyChainFailure({ tlsa: "weird" }), "GD_SITE_UNREACHABLE");
+  Assert.equal(classifyChainFailure({ block: "GD_NODE_SYNCING", tlsa: "ok" }), "GD_NODE_SYNCING");
+});
