+++ b/browser/components/greatdane/GreatDANEAbout.sys.mjs
@@ -25,6 +25,23 @@ const ERRORS = {
     "The name is on the chain but its server could not be reached through the node."],
 };
 
+const CHAIN_HOST = /\.(pepe|doge)\.?$/i;
+
+// Pure decision for a failed top-level load of a chain host. Anything we
+// cannot determine maps to a blocking interstitial, never to "open".
+//   block: GreatDANE.blockReason(c) or null; tlsa: node /gd/tlsa status, or
+//   null if the node could not be asked; tlsFail: true/false, or null if the
+//   failure kind is unknown (treated as a TLS failure: fail closed).
+export function classifyChainFailure({ block = null, tlsa = null, tlsFail = null } = {}) {
+  if (block) return block;
+  if (tlsa === null || tlsa === undefined) return "GD_NODE_NOT_READY";
+  if (tlsa == "unowned" || tlsa == "bad_name") return "GD_NAME_UNOWNED";
+  if (tlsa == "no_tlsa") return "GD_NO_TLSA";
+  if (tlsa == "bad_record") return "GD_BAD_TLSA";
+  if (tlsa == "ok") return tlsFail === false ? "GD_SITE_UNREACHABLE" : "GD_TLS_UNTRUSTED";
+  return "GD_SITE_UNREACHABLE";
+}
+
 const esc = s => String(s ?? "").replace(/[&<>"']/g, ch => "&#" + ch.charCodeAt(0) + ";");
 
 function safeTarget(u) {
@@ -33,7 +50,10 @@ function safeTarget(u) {
     if ((uri.scheme == "https" || uri.scheme == "http") && GreatDANE._chainFor(uri.host)) {
       return uri.spec;
     }
-  } catch (e) {}
+  } catch (e) {
+    // Unparseable/odd target: never echo it into a refresh/continue link.
+    console.error("GreatDANE: about:dane ignored bad target", u, e);
+  }
   return null;
 }
 
@@ -52,7 +72,7 @@ function chainRows() {
   return rows;
 }
 
-function render(uri) {
+export function _render(uri) {
   let q = new URLSearchParams(uri.query || "");
   let code = q.get("e");
   let target = safeTarget(q.get("u") || "");
@@ -94,7 +114,7 @@ ${chainRows()}</table><p class="code">Updates every ${refresh} s.</p></body></ht
 const AboutGreatDANE = {
   newChannel(uri, loadInfo) {
     let stream = Cc["@mozilla.org/io/string-input-stream;1"].createInstance(Ci.nsIStringInputStream);
-    stream.setUTF8Data(render(uri));
+    stream.setUTF8Data(_render(uri));
     let isc = Cc["@mozilla.org/network/input-stream-channel;1"].createInstance(Ci.nsIInputStreamChannel);
     isc.setURI(uri);
     isc.contentStream = stream;
@@ -132,19 +152,41 @@ export function registerAbout() {
 export const ErrorTrap = {
   onLocationChange(browser, webProgress, request, location, flags) {
     if (!webProgress.isTopLevel || !(flags & Ci.nsIWebProgressListener.LOCATION_CHANGE_ERROR_PAGE)) return;
+    if (!location.schemeIs("http") && !location.schemeIs("https")) return;
+    let host = location.asciiHost;
     let c = null;
-    try { c = GreatDANE._chainFor(location.host); } catch (e) { return; }
-    if (!c) return;
-    let code = GreatDANE.blockReason(c);
+    let lookupFailed = false;
+    try {
+      c = GreatDANE._chainFor(host);
+    } catch (e) {
+      console.error("GreatDANE: chain lookup failed for", host, e);
+      lookupFailed = true;
+    }
+    if (!c && !(lookupFailed && CHAIN_HOST.test(host))) return;
+    let code = c ? GreatDANE.blockReason(c) : "GD_NODE_NOT_READY";
     let status = 0;
-    try { status = request?.QueryInterface(Ci.nsIChannel).status; } catch (e) {}
+    let statusKnown = !request;
+    if (request) {
+      try {
+        status = request.QueryInterface(Ci.nsIChannel).status;
+        statusKnown = true;
+      } catch (e) {
+        console.error("GreatDANE: no channel status for", host, e);
+      }
+    }
     let mod = ((status >>> 16) & 0x7fff) - 0x45;
     // The error-page load usually carries no failed channel (status 0), so
     // also read which Firefox error page was shown: cert/NSS failures mean
     // the server's key did not verify against the chain.
-    let doc = "";
-    try { doc = browser.documentURI?.spec || ""; } catch (e) {}
