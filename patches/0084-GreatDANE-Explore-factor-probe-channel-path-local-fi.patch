+// ---- Probe status path (isolated local fixture; no chain DNS/TLSA). ----
+// Uses the same newProbeChannel()/runProbeChannel()/classifyProbe() code as
+// probeHttps(), against a loopback httpd.js server over plain HTTP. TLS/TLSA
+// is NOT exercised here (that is covered by live packaged-build runs).
+const { HttpServer } = ChromeUtils.importESModule(
+  "resource://testing-common/httpd.sys.mjs"
+);
+
+add_task(function test_classify_status() {
+  const { classifyProbe } = ChromeUtils.importESModule(
+    "resource:///modules/GreatDANEExplore.sys.mjs"
+  );
+  let ok = (status, rv = Cr.NS_OK, extra = {}) =>
+    classifyProbe({ rv, status, timedOut: false, secError: "", ...extra });
+  Assert.deepEqual(ok(200), { ok: true, status: 200, error: "" });
+  Assert.ok(ok(404).ok);
+  Assert.deepEqual(ok(500), { ok: false, status: 500, error: "HTTP_500" });
+  Assert.deepEqual(ok(503), { ok: false, status: 503, error: "HTTP_503" });
+  Assert.ok(ok(302, Cr.NS_ERROR_REDIRECT_LOOP).ok);
+  Assert.ok(ok(200, Cr.NS_BINDING_ABORTED).ok, "body cap cancel is not an error");
+  Assert.equal(ok(0, Cr.NS_ERROR_NET_TIMEOUT, { timedOut: true }).error, "TIMEOUT");
+  Assert.equal(
+    ok(0, Cr.NS_ERROR_FAILURE, { secError: "MOZILLA_PKIX_ERROR_KEY_PINNING_FAILURE" }).error,
+    "MOZILLA_PKIX_ERROR_KEY_PINNING_FAILURE"
+  );
+  Assert.ok(!ok(0, Cr.NS_ERROR_CONNECTION_REFUSED).ok);
+});
+
+add_task(async function test_probe_channel_fixture() {
+  const { newProbeChannel, runProbeChannel, PROBE_BODY_CAP } =
+    ChromeUtils.importESModule("resource:///modules/GreatDANEExplore.sys.mjs");
+  let hits = { target: 0, cookie: null };
+  let srv = new HttpServer();
+  srv.registerPathHandler("/ok", (req, resp) => {
+    hits.cookie = req.hasHeader("Cookie") ? req.getHeader("Cookie") : null;
+    resp.setStatusLine(req.httpVersion, 200, "OK");
+    resp.write("hello");
+  });
+  srv.registerPathHandler("/e500", (req, resp) => {
+    resp.setStatusLine(req.httpVersion, 500, "Internal Server Error");
+    resp.write("x");
+  });
+  srv.registerPathHandler("/e503", (req, resp) => {
+    resp.setStatusLine(req.httpVersion, 503, "Unavailable");
+  });
+  srv.registerPathHandler("/redir", (req, resp) => {
+    resp.setStatusLine(req.httpVersion, 302, "Found");
+    resp.setHeader("Location", "http://localhost:" + srv.identity.primaryPort + "/target");
+  });
+  srv.registerPathHandler("/target", (req, resp) => {
+    hits.target++;
+    resp.setStatusLine(req.httpVersion, 200, "OK");
+  });
+  srv.registerPathHandler("/big", (req, resp) => {
+    resp.setStatusLine(req.httpVersion, 200, "OK");
+    resp.write("a".repeat(PROBE_BODY_CAP * 8));
+  });
+  srv.start(-1);
+  let base = "http://localhost:" + srv.identity.primaryPort;
+  try {
+    let r = await runProbeChannel(newProbeChannel(base + "/ok"), 5000);
+    Assert.ok(r.ok);
+    Assert.equal(r.status, 200);
+    Assert.equal(hits.cookie, null, "anonymous: no cookies sent");
+
+    r = await runProbeChannel(newProbeChannel(base + "/e500"), 5000);
+    Assert.ok(!r.ok);
+    Assert.equal(r.error, "HTTP_500");
+    r = await runProbeChannel(newProbeChannel(base + "/e503"), 5000);
+    Assert.equal(r.error, "HTTP_503");
+
+    r = await runProbeChannel(newProbeChannel(base + "/redir"), 5000);
+    Assert.equal(r.status, 302);
+    Assert.ok(r.ok, "3xx counts as answered");
+    Assert.equal(hits.target, 0, "redirect not followed");
+
+    r = await runProbeChannel(newProbeChannel(base + "/big"), 5000);
+    Assert.ok(r.ok);
+    Assert.ok(r.capped, "body read cancelled at cap");
+    Assert.less(r.bytes, PROBE_BODY_CAP * 8);
+  } finally {
+    await new Promise(res => srv.stop(res));
+  }
+  // Unreachable port: transport error surfaces.
+  let r = await runProbeChannel(newProbeChannel("http://127.0.0.1:1/"), 3000);
+  Assert.ok(!r.ok);
+  Assert.ok(r.error.length);
+});
+
+add_task(async function test_default8_round_restart_and_time_advance() {
+  do_get_profile();
+  Services.prefs.clearUserPref("greatdane.explore.globalBudgetPerWeek");
+  const { readCache, writeCache, globalBudgetRemaining, canStartSampleRound } =
+    ChromeUtils.importESModule("resource:///modules/GreatDANEExplore.sys.mjs");
+  let now = Date.now();
+  let log = [];
+  for (let i = 0; i < 8; i++) {
+    log.push({ host: "h" + i + ".doge", at: now - i * 1000, ok: i % 2 == 0, status: 200, error: "" });
+  }
+  await writeCache({ lastSampleAt: now, live: [], probeLog: log });
+  let c = await readCache();
+  Assert.equal(c.probeLog.length, 8);
+  Assert.equal(globalBudgetRemaining(c, now), 0, "default cap 8 exhausted");
+  Assert.ok(!canStartSampleRound(c, now + 2 * 24 * 3600 * 1000), "no round while budget 0");
+  let later = now + 8 * 24 * 3600 * 1000;
+  Assert.equal(globalBudgetRemaining(c, later), 8, "restores to 8 after 8d");
+  Assert.ok(canStartSampleRound(c, later));
+});
