+
+export const PROBE_BODY_CAP = 65536;
+
+/** Build the anonymous, uncached, no-redirect probe channel for `url`. */
+export function newProbeChannel(url) {
+  let ch = lazy.NetUtil.newChannel({
+    uri: url,
+    loadUsingSystemPrincipal: true,
+    contentPolicyType: Ci.nsIContentPolicy.TYPE_OTHER,
+  }).QueryInterface(Ci.nsIHttpChannel);
+  ch.loadFlags |=
+    Ci.nsIRequest.LOAD_ANONYMOUS |
+    Ci.nsIRequest.LOAD_BYPASS_CACHE |
+    Ci.nsIRequest.INHIBIT_CACHING |
+    Ci.nsIChannel.LOAD_BACKGROUND;
+  ch.redirectionLimit = 0;
+  return ch;
+}
+
+/**
+ * Pure status classification shared by the real channel path.
+ * ok iff no transport/TLS error and 200 <= status < 500.
+ */
+export function classifyProbe({ rv, status, timedOut, secError }) {
+  let error = "";
+  if (timedOut) {
+    error = "TIMEOUT";
+  } else if (!Components.isSuccessCode(rv) && rv != Cr.NS_BINDING_ABORTED) {
+    if (rv == Cr.NS_ERROR_REDIRECT_LOOP && status >= 300 && status < 400) {
+      error = ""; // redirectionLimit hit: server answered with 3xx
+    } else {
+      // Real reason, e.g. NS_ERROR_UNKNOWN_HOST, PROXY_CONNECTION_REFUSED,
+      // or a PSM/TLSA failure (MOZILLA_PKIX_ERROR_KEY_PINNING_FAILURE).
+      error =
+        secError ||
+        ChromeUtils.getXPCOMErrorName?.(rv) ||
+        "0x" + (rv >>> 0).toString(16);
     }
+  }
+  let ok = !error && status >= 200 && status < 500;
+  if (!error && !ok) {
+    error = "HTTP_" + status;
+  }
+  return { ok, status, error };
+}
