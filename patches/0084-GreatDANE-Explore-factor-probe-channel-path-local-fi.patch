     let settled = false;
     let timedOut = false;
+    let capped = false;
     let bytes = 0;
     let timer = lazy.setTimeout(() => {
       timedOut = true;
       ch.cancel(Cr.NS_ERROR_NET_TIMEOUT);
     }, Math.max(500, timeoutMs));
-    ch.asyncOpen({
