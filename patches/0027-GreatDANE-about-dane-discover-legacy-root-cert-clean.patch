diff --git a/browser/components/greatdane/GreatDANEDiscover.sys.mjs b/browser/components/greatdane/GreatDANEDiscover.sys.mjs
new file mode 100644
index 0000000000..3f8a6899b4
--- /dev/null
+++ b/browser/components/greatdane/GreatDANEDiscover.sys.mjs
@@ -0,0 +1,132 @@
+/* GreatDANE: about:dane-discover — a read-only directory of chain names.
+ * Source: each running node's loopback /gd/names?prefix=P&limit=N (the same
+ * endpoint the urlbar provider uses). No wallet, no network beyond loopback.
+ * The node answers nothing for an empty prefix and caps limit at 20, so the
+ * unfiltered view asks once per first character. Generated in the parent,
+ * no script (CSP default-src 'none'); search is a plain GET form. */
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  GreatDANE: "resource:///modules/GreatDANE.sys.mjs",
+  setTimeout: "resource://gre/modules/Timer.sys.mjs",
+});
+
+export const LIMIT = 20;
+const FIRST = "abcdefghijklmnopqrstuvwxyz0123456789".split("");
+const LABEL = /^[a-z0-9-]{1,63}$/;
+const esc = s => String(s ?? "").replace(/[&<>"']/g, ch => "&#" + ch.charCodeAt(0) + ";");
+
+// "foo", "foo.pe", "foo.pepe" -> { label, suffix }; null if not searchable.
+export function parseQuery(q) {
+  q = String(q ?? "").trim().toLowerCase().replace(/^https?:\/\//, "").replace(/[/.]+$/, "");
+  if (!q) return { label: "", suffix: null };
+  let [label, suffix = null, extra] = q.split(".");
+  if (extra !== undefined || !LABEL.test(label)) return null;
+  if (suffix !== null && !/^[a-z]{0,15}$/.test(suffix)) return null;
+  return { label, suffix };
+}
+
+// Prefixes to ask the node for a parsed query.
+export function prefixesFor(pq) {
+  return pq.label ? [pq.label] : FIRST;
+}
+
+// Only well-formed labels survive; sorted, de-duplicated hosts.
+export function collect(lists) {
+  let out = new Set();
+  for (let { tld, names } of lists) {
+    if (!/^[a-z]{2,15}$/.test(tld || "")) continue;
+    for (let n of names || []) if (typeof n == "string" && LABEL.test(n)) out.add(n + "." + tld);
+  }
+  return [...out].sort((a, b) => a.localeCompare(b));
+}
+
+async function fetchNames(port, prefix) {
+  try {
+    let r = await Promise.race([
+      fetch(`http://127.0.0.1:${port}/gd/names?prefix=${encodeURIComponent(prefix)}&limit=${LIMIT}`,
+            { cache: "no-store" }),
+      new Promise((_, rej) => lazy.setTimeout(() => rej(new Error("timeout")), 1500)),
+    ]);
+    let j = await r.json();
+    return Array.isArray(j?.names) ? j.names : [];
+  } catch (e) {
+    return [];
+  }
+}
+
+export async function lookup(pq, chains = [...(lazy.GreatDANE._chains?.values() ?? [])]) {
+  let live = chains.filter(c => c.ports && (pq.suffix === null || c.tld.startsWith(pq.suffix)));
+  let lists = [];
+  for (let c of live) {
+    let names = (await Promise.all(prefixesFor(pq).map(p => fetchNames(c.ports.pac, p)))).flat();
+    lists.push({ tld: c.tld, names });
+  }
+  return { hosts: collect(lists), live: live.map(c => c.tld), down: chains.filter(c => !c.ports).map(c => c.tld) };
+}
+
+export function renderDiscover(rawQ, pq, res) {
+  let rows = res.hosts.map(h =>
+    `<li><a href="https://${esc(h)}/">${esc(h)}</a></li>`).join("");
+  let note = !pq ? "Not a valid name search." :
+    res.hosts.length ? `${res.hosts.length} name${res.hosts.length == 1 ? "" : "s"}` +
+      (pq.label ? "" : ` (up to ${LIMIT} per first letter; search to narrow)`) :
+    res.live.length ? "No names found." : "No node is ready yet; names appear once it is running.";
+  let down = res.down.length ? `<p class="code">Not running: ${res.down.map(t => "." + esc(t)).join(", ")}</p>` : "";
+  return `<!DOCTYPE html><html><head><meta charset="utf-8">
+<link rel="icon" href="chrome://branding/content/icon32.png">
+<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; img-src chrome:; form-action about:">
+<title>Discover chain names</title><style>
+:root{color-scheme:light dark;--bg:light-dark(#f4f6fb,#0b1b35);--fg:light-dark(#13254a,#e6ecf5);--line:light-dark(#d5dbe8,#22345c)}
+body{font:15px system-ui,sans-serif;background:var(--bg);color:var(--fg);margin:40px auto;max-width:900px}
+.logo{display:block;width:72px;margin:0 auto 6px}input{font:inherit;padding:6px 10px;width:60%}
+ul{columns:3;list-style:none;padding:0}li{padding:3px 0}a{color:light-dark(#2a5bb8,#9cc4ff)}.code{color:#888;font-size:12px}</style></head><body>
+<img class="logo" alt="" src="chrome://branding/content/about-logo.svg"><h1 style="text-align:center">Discover</h1>
+<p>Registered .pepe and .doge names known to Dane's built-in nodes. Read only.</p>
+<form method="get" action="about:dane-discover"><input id="q" name="q" type="search" value="${esc(rawQ)}" placeholder="name or name.pepe" autofocus> <button>Search</button></form>
+<p id="note">${note}</p>${down}<ul id="names">${rows}</ul></body></html>`;
+}
+
+function utf8Bin(s) {
+  let b = new TextEncoder().encode(s), out = "";
+  for (let i = 0; i < b.length; i += 8192) out += String.fromCharCode(...b.subarray(i, i + 8192));
+  return out;
+}
+
+const AboutDiscover = {
+  newChannel(uri, loadInfo) {
+    let pipe = Cc["@mozilla.org/pipe;1"].createInstance(Ci.nsIPipe);
+    pipe.init(true, true, 0, 0xffffffff, null);
+    let isc = Cc["@mozilla.org/network/input-stream-channel;1"].createInstance(Ci.nsIInputStreamChannel);
+    isc.setURI(uri);
+    isc.contentStream = pipe.inputStream;
+    let ch = isc.QueryInterface(Ci.nsIChannel);
+    ch.contentType = "text/html";
+    ch.contentCharset = "UTF-8";
+    ch.loadInfo = loadInfo;
+    ch.originalURI = uri;
+    let rawQ = new URLSearchParams(uri.query || "").get("q") || "";
+    let pq = parseQuery(rawQ);
+    (pq ? lookup(pq) : Promise.resolve({ hosts: [], live: [], down: [] }))
+      .catch(e => { console.error("GreatDANE: discover failed", e); return { hosts: [], live: [], down: [] }; })
+      .then(res => {
+        let s = utf8Bin(renderDiscover(rawQ, pq, res));
+        try { pipe.outputStream.write(s, s.length); } catch (e) { console.error(e); }
+        pipe.outputStream.close();
+      });
+    return ch;
+  },
+  getURIFlags() { return Ci.nsIAboutModule.HIDE_FROM_ABOUTABOUT; },
+  getChromeURI(uri) { return uri; },
+  QueryInterface: ChromeUtils.generateQI(["nsIAboutModule"]),
+};
+
+export function registerDiscover() {
+  let reg = Components.manager.QueryInterface(Ci.nsIComponentRegistrar);
+  const CID = Components.ID("{3b9f6a0c-1e52-4d7a-8c61-0f2a9d4e7b15}");
+  if (reg.isCIDRegistered(CID)) return;
+  reg.registerFactory(CID, "about:dane-discover", "@mozilla.org/network/protocol/about;1?what=dane-discover", {
+    createInstance(iid) { return AboutDiscover.QueryInterface(iid); },
+    QueryInterface: ChromeUtils.generateQI(["nsIFactory"]),
+  });
+}
diff --git a/browser/components/greatdane/GreatDANELegacy.sys.mjs b/browser/components/greatdane/GreatDANELegacy.sys.mjs
new file mode 100644
index 0000000000..a3ccdca1aa
--- /dev/null
+++ b/browser/components/greatdane/GreatDANELegacy.sys.mjs
@@ -0,0 +1,171 @@
+/* GreatDANE: one-time migration helpers for users of the legacy PepeNet
+ * tools (pepenet-desktop / pepenet-tls / get.sh).
+ *
+ * 1. Legacy root CAs. pepenet-tls (tls/src/ca.c) minted a local,
+ *    name-constrained root per TLD with subject exactly
+ *    "CN=<name> .<tld> root CA" (name "pepenet", self-issued). Dane never
+ *    needs it (DANE is checked in PSM). We match only that exact subject,
+ *    self-issued, not a built-in root; nothing else is ever touched, and
+ *    nothing is removed without the user saying yes. Private key files are
+ *    never opened. macOS keychain hits are listed only, never removed.
+ *
+ * 2. Chain data import. If ~/.pepenet/<coin>.db exists and Dane's node data
+ *    dir has no <coin>/<coin>.db, offer to COPY it (with -wal/-shm). The
+ *    legacy files are never moved, changed or deleted. The copy is checked
+ *    (sqlite quick_check + a names table); on any failure the copy is
+ *    removed and the node syncs from scratch as usual. */
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  Subprocess: "resource://gre/modules/Subprocess.sys.mjs",
+  Sqlite: "resource://gre/modules/Sqlite.sys.mjs",
+});
+
+const log = (...a) => console.log("GreatDANE legacy:", ...a);
+export const LEGACY_NAME = "pepenet";
+export const LEGACY_TLDS = ["pepe", "doge"];
+// Fingerprints of legacy roots seen on the dev machine (public certs only),
+// kept for logging/diagnostics. Matching is by exact subject + self-issued,
+// because every install generated its own key.
+export const KNOWN_FPS = new Set([
+  "DE:94:BD:E8:06:0D:C6:5D:66:DF:BA:76:CA:F3:C0:76:19:82:C9:8A:A5:B1:51:75:D8:B3:E1:6A:57:A6:92:CB",
+  "B3:05:DE:83:D0:2A:C4:BC:AB:04:1A:F3:E4:C8:3D:A4:38:47:5B:1B:47:F8:EB:5C:D1:29:E7:88:AE:00:5C:8A",
+  "14:44:01:C9:20:64:E0:5E:47:DA:36:92:2B:79:37:9C:02:CA:77:47:4E:49:C0:2F:51:A9:64:DE:BB:4E:6B:BC",
+]);
+export const LEGACY_SUBJECTS = new Set(LEGACY_TLDS.map(t => `CN=${LEGACY_NAME} .${t} root CA`));
+
+// Pure: is this nsIX509Cert-like object one of the legacy PepeNet roots?
+export function isLegacyRoot(cert) {
+  if (!cert || cert.isBuiltInRoot) return false;
+  return LEGACY_SUBJECTS.has(cert.subjectName) && cert.issuerName === cert.subjectName;
+}
+
+function certdb() {
+  return Cc["@mozilla.org/security/x509certdb;1"].getService(Ci.nsIX509CertDB);
+}
+
+export function findLegacyRoots(db = certdb()) {
+  return db.getCerts().filter(isLegacyRoot);
+}
+
+// Removes exactly the given certs, re-checking each first.
+export function removeLegacyRoots(certs, db = certdb()) {
+  let removed = 0;
+  for (let c of certs) {
+    if (!isLegacyRoot(c)) continue;
+    db.deleteCertificate(c);
+    removed++;
+    log("removed", c.subjectName, c.sha256Fingerprint, KNOWN_FPS.has(c.sha256Fingerprint) ? "(known)" : "");
+  }
+  return removed;
+}
+
+// macOS only, list-only: legacy roots in the user's keychains. Exact subject
+// CN match on the output of `security find-certificate -a -Z -c`.
+export async function listKeychainLegacy() {
+  if (Services.appinfo.OS != "Darwin") return [];
+  let hits = [];
+  for (let t of LEGACY_TLDS) {
+    let cn = `${LEGACY_NAME} .${t} root CA`;
+    try {
+      let p = await lazy.Subprocess.call({
+        command: "/usr/bin/security", arguments: ["find-certificate", "-a", "-Z", "-c", cn],
+        stderr: "pipe",
+      });
+      let out = "", s;
+      while ((s = await p.stdout.readString())) out += s;
+      await p.wait();
+      let sha = null;
+      for (let line of out.split("\n")) {
+        let m = /^SHA-256 hash:\s*([0-9A-F]+)/.exec(line);
+        if (m) sha = m[1];
+        if (line.includes(`"labl"<blob>="${cn}"`) && sha) { hits.push({ cn, sha256: sha }); sha = null; }
+      }
+    } catch (e) {
+      log("keychain listing failed", e);
+    }
+  }
+  return hits;
+}
+
+export async function offerCertCleanup(win, { db = certdb(), prompt = Services.prompt, listKeychain = listKeychainLegacy } = {}) {
+  let found = findLegacyRoots(db);
+  let kc = await listKeychain().catch(() => []);
+  if (!found.length && !kc.length) return { found: 0, removed: 0, keychain: 0 };
+  let msg = "Dane found root certificates installed by the old PepeNet tools. Dane does not need them: it checks .pepe and .doge sites against the chain directly.\n\n";
+  if (found.length) msg += "In Dane:\n" + found.map(c => "  " + c.subjectName + "\n  SHA-256 " + c.sha256Fingerprint).join("\n") + "\n\n";
+  if (kc.length) msg += "In your macOS keychain (Dane will not change these; remove them in Keychain Access, or with the old tool's uninstall-ca):\n" + kc.map(k => "  CN=" + k.cn + "  SHA-256 " + k.sha256).join("\n") + "\n\n";
+  let removed = 0;
+  if (found.length) {
+    msg += "Remove the " + found.length + " certificate(s) listed under \"In Dane\"? No other certificates are touched.";
+    if (prompt.confirm(win, "Old PepeNet certificates", msg)) removed = removeLegacyRoots(found, db);
+  } else {
+    prompt.alert(win, "Old PepeNet certificates", msg);
+  }
+  return { found: found.length, removed, keychain: kc.length };
+}
+
+// ---- chain data import ----
+
+const exists = p => IOUtils.exists(p);
+
+export function legacyDir() {
+  return PathUtils.join(Services.dirsvc.get("Home", Ci.nsIFile).path, "." + LEGACY_NAME);
+}
+
+// { src, dst } if a copy should be offered for this coin, else null.
+export async function importCandidate(coin, dataDir, legacy = legacyDir()) {
+  if (!/^[a-z]+$/.test(coin)) return null;
+  let src = PathUtils.join(legacy, coin + ".db");
+  let dstDir = PathUtils.join(dataDir, coin);
+  let dst = PathUtils.join(dstDir, coin + ".db");
+  if (!(await exists(src))) return null;
+  if (await exists(dst)) return null; // Dane already has data: never overwrite
+  return { src, dst, dstDir };
+}
+
+export async function validateChainDb(path) {
+  let conn = null;
+  try {
+    conn = await lazy.Sqlite.openConnection({ path, readOnly: true });
+    let qc = await conn.execute("PRAGMA quick_check");
+    if (!qc.length || qc[0].getResultByIndex(0) != "ok") return false;
+    let t = await conn.execute("SELECT count(*) FROM sqlite_master WHERE type='table' AND name='names'");
+    return t[0].getResultByIndex(0) == 1;
+  } catch (e) {
+    log("validate failed", path, e);
+    return false;
+  } finally {
+    try { await conn?.close(); } catch (e) {}
+  }
+}
+
+async function removeCopy(dst) {
+  for (let s of ["", "-wal", "-shm"]) {
+    try { await IOUtils.remove(dst + s, { ignoreAbsent: true }); } catch (e) {}
+  }
+}
+
+// Copy (never move) src(+wal/shm) to dst, validate; undo the copy on failure.
+export async function copyChainDb({ src, dst, dstDir }) {
+  try {
+    await IOUtils.makeDirectory(dstDir, { createAncestors: true, ignoreExisting: true });
+    for (let s of ["", "-wal", "-shm"]) {
+      if (await exists(src + s)) await IOUtils.copy(src + s, dst + s, { noOverwrite: true });
+    }
+    if (await validateChainDb(dst)) { log("imported", src, "->", dst); return true; }
+  } catch (e) {
+    log("copy failed", src, e);
+  }
+  await removeCopy(dst);
+  return false;
+}
+
+export async function offerImport(win, cand, coin, { prompt = Services.prompt } = {}) {
+  let ok = prompt.confirm(win, "Use existing PepeNet chain data?",
+    `Dane found ${coin} chain data from the old PepeNet app:\n  ${cand.src}\n\n` +
+    "Copy it into Dane so the node does not have to sync from scratch? " +
+    "The original files are left exactly as they are. If the copy fails its check, Dane syncs normally.");
+  if (!ok) return "declined";
+  return (await copyChainDb(cand)) ? "imported" : "failed";
+}
