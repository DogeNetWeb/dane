diff --git a/browser/components/greatdane/test/marionette/run_gd_legacy.py b/browser/components/greatdane/test/marionette/run_gd_legacy.py
new file mode 100644
index 0000000000..b3f89dae14
--- /dev/null
+++ b/browser/components/greatdane/test/marionette/run_gd_legacy.py
@@ -0,0 +1,174 @@
+# Dane legacy-migration + Discover tests (chrome context via Marionette).
+# Loads the NEW modules from the source tree by file:// URI, so it runs
+# against any built Dane (no rebuild needed for these checks). Throwaway
+# profile, greatdane.enabled=false (no node, never the real data dir),
+# throwaway cert/db fixtures; never touches the real NSS store, keychain or
+# ~/.pepenet.
+#   python3 run_gd_legacy.py [path/to/greatdane]
+import base64, hashlib, http.server, json, os, sqlite3, subprocess, sys, tempfile, threading, time
+from marionette_driver.marionette import Marionette
+HERE = os.path.dirname(os.path.abspath(__file__))
+SRC = os.path.abspath(os.path.join(HERE, "../.."))
+TREE = os.path.abspath(os.path.join(HERE, "../../../../.."))
+APP = sys.argv[1] if len(sys.argv) > 1 else TREE + "/obj-gd/dist/Dane.app/Contents/MacOS/greatdane"
+PORT = 2834
+work = tempfile.mkdtemp(prefix="gd-legacy-")
+prof = os.path.join(work, "profile"); os.makedirs(prof)
