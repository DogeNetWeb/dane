diff --git a/modules/libpref/init/StaticPrefList-greatdane-node.inc.yaml b/modules/libpref/init/StaticPrefList-greatdane-node.inc.yaml
new file mode 100644
index 0000000..cef2348
--- /dev/null
+++ b/modules/libpref/init/StaticPrefList-greatdane-node.inc.yaml
@@ -0,0 +1,22 @@
+# Fragment to merge into modules/libpref/init/StaticPrefList.yaml
+# (after the "gl." section, before "html5."). See StaticPrefList.yaml.patch.
+#---------------------------------------------------------------------------
+# Prefs starting with "greatdane."
+#---------------------------------------------------------------------------
+
+# Lazy node: sync only the namespace; fetch a name's DNS zone when a query
+# arrives, instead of syncing full zones up front. Default off.
+# These are mirror:always so the TLS verifier can read them off the cert
+# thread (Preferences::Get* is main-thread-only and would assert/crash).
+# Defaults are owned here; do not also pref() them in firefox.js.
+- name: greatdane.node.lazy
+  type: bool
+  value: false
+  mirror: always
+
+# Bounded wait (seconds) for a cold zone fetch. The C++ verifier still
+# clamps this to [1, 60].
+- name: greatdane.node.lazyTimeoutSec
+  type: int32_t
+  value: 10
+  mirror: always
