---
 mozconfig-x86_64 | 11 +++++++++++
 1 file changed, 11 insertions(+)
 create mode 100644 mozconfig-x86_64

diff --git a/mozconfig-x86_64 b/mozconfig-x86_64
new file mode 100644
index 0000000000..4e4ec14870
--- /dev/null
+++ b/mozconfig-x86_64
@@ -0,0 +1,11 @@
+# GreatDANE Intel slice (cross-compiled on arm64). Universal = obj-gd + this, via unify.
+ac_add_options --enable-application=browser
+ac_add_options --target=x86_64-apple-darwin
+ac_add_options --with-branding=browser/branding/greatdane
+ac_add_options --with-app-basename=GreatDANE
+ac_add_options --disable-tests
+ac_add_options --disable-debug
+ac_add_options --disable-crashreporter
+mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-gd-x86_64
+ac_add_options --with-onnx-runtime
+ac_add_options --enable-bootstrap=onnxruntime-x86_64-apple-darwin
