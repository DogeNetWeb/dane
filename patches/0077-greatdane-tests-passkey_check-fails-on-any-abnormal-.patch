From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nowon <nowon@noreply.pepecoin.surf>
Date: Sun, 1 Nov 2026 09:13:01 -0600
Subject: [PATCH 077/144] greatdane/tests: passkey_check fails on any abnormal
 browser exit; own process group + killpg; guarded post-kill wait; Marionette
 errors become FAIL; quit error logged; leftover-process check;
 marionette.port=0 via MarionetteActivePort with profile verification;
 force-kill test hook; note background traffic

---
 greatdane/tests/README.md        |  2 +-
 greatdane/tests/passkey_check.py | 92 ++++++++++++++++++++------------
 2 files changed, 60 insertions(+), 34 deletions(-)

diff --git a/greatdane/tests/README.md b/greatdane/tests/README.md
index aeb50f4dd3..5f2584c4e3 100644
--- a/greatdane/tests/README.md
+++ b/greatdane/tests/README.md
@@ -13,4 +13,4 @@ The expected BuildID never comes from the app itself. Checks application.ini ==
 run_gd_prefs.py: `run_gd_prefs.py <greatdane> [arm64|x86_64] [/abs/screens_dir]`. Without an arch it runs natively. Before this change, a second argument was taken as the screens dir.
 guard_negative_test.py: proves gd_guard rejects out-of-root dataDir and safe() paths and stray dirs in the source tree. Launches no browser.
 gd_guard now requires every profile and node data path to be inside this run's mkdtemp roots. At exit, it fails with code 96 if a profile's dataDir is outside them, or if new dirs appeared in greatdane/, the cwd, or $HOME.
-passkey_check.py: `passkey_check.py <Dane.app> <arm64|x86_64> [--static-only]`. Passkey READINESS check (PASSKEYS-PLAN.md §5). A pass is not proof that passkeys work: it only shows there are no stray restricted entitlements, the pref is on and the generic WebAuthn API exists. Static: with no Contents/embedded.provisionprofile, no Mach-O may carry com.apple.developer.web-browser.public-key-credential or com.apple.application-identifier. With a profile, only the main app may carry both (MNL79V994R.surf.dogecoin.dane), and the profile must grant them. Runtime (gd_guard throwaway profile, ABI gate, free Marionette port picked at run time, child killed if it does not quit in 30s): security.webauthn.enable_macos_passkeys is true and PublicKeyCredential exists. The runtime part makes one network request, to https://example.com/ (needed for a secure context). Read-only on the bundle; changes no signing inputs.
+passkey_check.py: `passkey_check.py <Dane.app> <arm64|x86_64> [--static-only]`. Passkey READINESS check (PASSKEYS-PLAN.md §5). A pass is not proof that passkeys work: it only shows there are no stray restricted entitlements, the pref is on and the generic WebAuthn API exists. Static: with no Contents/embedded.provisionprofile, no Mach-O may carry com.apple.developer.web-browser.public-key-credential or com.apple.application-identifier. With a profile, only the main app may carry both (MNL79V994R.surf.dogecoin.dane), and the profile must grant them. Runtime (gd_guard throwaway profile, ABI gate; marionette.port=0 with the port read from <profile>/MarionetteActivePort and the profile path verified over Marionette; browser launched in its own session and its process group killed if it does not quit in 30s): security.webauthn.enable_macos_passkeys is true and PublicKeyCredential exists. Any non-zero browser exit, Marionette error, or process left on the throwaway profile is a FAIL (script exits 1). Test hook: GD_PASSKEY_TEST_FORCE_KILL=1 SIGKILLs the browser to prove that path fails. The runtime part makes one network request, to https://example.com/ (needed for a secure context), plus stock Firefox background traffic. Read-only on the bundle; changes no signing inputs.
diff --git a/greatdane/tests/passkey_check.py b/greatdane/tests/passkey_check.py
index 84f3997b5a..5358ad263f 100644
--- a/greatdane/tests/passkey_check.py
+++ b/greatdane/tests/passkey_check.py
@@ -2,8 +2,11 @@
 # A PASS is NOT proof that passkeys work. It only means: no stray restricted entitlements (or, once a profile is
 # embedded, a consistent entitlement/profile pairing), the pref security.webauthn.enable_macos_passkeys is on, and the
 # generic WebAuthn API (PublicKeyCredential, navigator.credentials) exists. It does not run a platform-passkey ceremony.
-# NETWORK: the runtime part navigates to https://example.com/ (one request) to get a secure context.
+# NETWORK: the runtime part navigates to https://example.com/ (one request) to get a secure context, plus stock
+#   Firefox background traffic (e.g. Remote Settings, captive-portal and update checks) from the throwaway profile.
 # Usage: passkey_check.py <Dane.app> <arm64|x86_64> [--static-only]
+# A non-zero browser exit (crash, signal, kill) is a FAIL. Test hook: GD_PASSKEY_TEST_FORCE_KILL=1 SIGKILLs the browser
+#   group instead of quitting, to prove that path ends in FAIL with a non-zero script exit.
 # Static (no launch): if Contents/embedded.provisionprofile is ABSENT, no Mach-O in the bundle may carry
 #   com.apple.developer.web-browser.public-key-credential or com.apple.application-identifier (expected today).
 #   If PRESENT: the main app must carry both (application-identifier == MNL79V994R.surf.dogecoin.dane),
@@ -12,7 +15,7 @@
 #   and PublicKeyCredential / navigator.credentials exist. Never touches signing inputs or Apple accounts.
 import os as _os, sys as _sys; _sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), "..", "tools"))
 import gd_guard  # must be first: real-profile guard + throwaway dirs
-import os, sys, subprocess, plistlib, socket
+import os, sys, subprocess, plistlib, signal, time
 PK = "com.apple.developer.web-browser.public-key-credential"
 AI = "com.apple.application-identifier"
 WANT_AI = "MNL79V994R.surf.dogecoin.dane"
@@ -61,37 +64,60 @@ print("READINESS STATIC", "OK" if not fails else "FAIL", fails, flush=True)
 
 if not STATIC_ONLY:
     from marionette_driver.marionette import Marionette
-    def free_port():
-        s = socket.socket(); s.bind(("127.0.0.1", 0)); port = s.getsockname()[1]; s.close(); return port
-    MPORT = free_port()
-    c = socket.socket()
-    if c.connect_ex(("127.0.0.1", MPORT)) == 0:
-        sys.exit("FAIL: picked Marionette port %d but something is listening on it" % MPORT)
-    c.close()
-    print("marionette port:", MPORT)
     pd = gd_guard.profile("gd-test-")
-    open(pd + "/user.js", "w").write('user_pref("marionette.port", %d);\n' % MPORT + 'user_pref("greatdane.node.dataDir", "' + gd_guard.safe(gd_guard.ND) + '");\nuser_pref("greatdane.pep.listen_port", 34875);\nuser_pref("greatdane.doge.listen_port", 23557);\nuser_pref("greatdane.legacy.certCleanup", false);\nuser_pref("greatdane.legacy.import", false);\nuser_pref("browser.shell.checkDefaultBrowser", false);\n')
-    p = subprocess.Popen(["arch", "-" + ARCH, main, "-marionette", "-remote-allow-system-access", "-no-remote", "-profile", pd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
-    m = Marionette(host="127.0.0.1", port=MPORT); m.start_session()
-    want_abi = {"arm64": "aarch64-gcc3", "x86_64": "x86_64-gcc3"}[ARCH]
-    with m.using_context("chrome"):
-        abi = m.execute_script("return Services.appinfo.XPCOMABI")
-        pref = m.execute_script("return Services.prefs.getBoolPref('security.webauthn.enable_macos_passkeys', false)")
-    print("ABI-MARKER requested=%s XPCOMABI=%s %s" % (ARCH, abi, "OK" if abi == want_abi else "MISMATCH"), flush=True)
-    if abi != want_abi: fails.append("ABI mismatch")
-    m.navigate("https://example.com/")
-    api = m.execute_script("return [typeof PublicKeyCredential, typeof navigator.credentials, isSecureContext]")
-    print("runtime: enable_macos_passkeys=%s api=%s" % (pref, api))
-    if pref is not True: fails.append("pref security.webauthn.enable_macos_passkeys is not true")
-    if api[0] != "function" or api[1] != "object": fails.append("WebAuthn API missing: %s" % api)
+    # marionette.port=0: Firefox binds a free port itself and writes it to <profile>/MarionetteActivePort (no race).
+    open(pd + "/user.js", "w").write('user_pref("marionette.port", 0);\n' + 'user_pref("greatdane.node.dataDir", "' + gd_guard.safe(gd_guard.ND) + '");\nuser_pref("greatdane.pep.listen_port", 34875);\nuser_pref("greatdane.doge.listen_port", 23557);\nuser_pref("greatdane.legacy.certCleanup", false);\nuser_pref("greatdane.legacy.import", false);\nuser_pref("browser.shell.checkDefaultBrowser", false);\n')
+    p = subprocess.Popen(["arch", "-" + ARCH, main, "-marionette", "-remote-allow-system-access", "-no-remote", "-profile", pd],
+                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
+    def killgrp(sig=signal.SIGKILL):
+        try: os.killpg(p.pid, sig)
+        except ProcessLookupError: pass
+    m = None; killed = False
     try:
-        with m.using_context("chrome"): m.execute_script("Services.startup.quit(Ci.nsIAppStartup.eAttemptQuit)")
-    except Exception: pass
-    try:
-        p.wait(30)
-    except subprocess.TimeoutExpired:
-        p.kill(); p.wait(10); fails.append("browser did not quit within 30s; killed")
-    print(ARCH, "exit", p.returncode)
-    if p.returncode != 0: fails.append("browser exited abnormally (%s)" % p.returncode)
-print("READINESS RESULT", "PASS" if not fails else "FAIL", fails)
+        apf = os.path.join(pd, "MarionetteActivePort"); t0 = time.time(); MPORT = None
+        while time.time() - t0 < 60 and p.poll() is None:
+            try: MPORT = int(open(apf).read().strip()); break
+            except (OSError, ValueError): time.sleep(0.25)
+        if MPORT is None: raise RuntimeError("no MarionetteActivePort in profile within 60s (browser exit %s)" % p.poll())
+        print("marionette port:", MPORT, "(from MarionetteActivePort)")
+        m = Marionette(host="127.0.0.1", port=MPORT); m.start_session()
+        want_abi = {"arm64": "aarch64-gcc3", "x86_64": "x86_64-gcc3"}[ARCH]
+        with m.using_context("chrome"):
+            abi = m.execute_script("return Services.appinfo.XPCOMABI")
+            pref = m.execute_script("return Services.prefs.getBoolPref('security.webauthn.enable_macos_passkeys', false)")
+            ppath = m.execute_script("return Services.dirsvc.get('ProfD', Ci.nsIFile).path")
+        if os.path.realpath(ppath) != os.path.realpath(pd): raise RuntimeError("Marionette on port %d is not our browser (profile %s)" % (MPORT, ppath))
+        print("ABI-MARKER requested=%s XPCOMABI=%s %s" % (ARCH, abi, "OK" if abi == want_abi else "MISMATCH"), flush=True)
+        if abi != want_abi: fails.append("ABI mismatch")
+        m.navigate("https://example.com/")
+        api = m.execute_script("return [typeof PublicKeyCredential, typeof navigator.credentials, isSecureContext]")
+        print("runtime: enable_macos_passkeys=%s api=%s" % (pref, api))
+        if pref is not True: fails.append("pref security.webauthn.enable_macos_passkeys is not true")
+        if api[0] != "function" or api[1] != "object": fails.append("WebAuthn API missing: %s" % api)
+    except Exception as ex:
+        fails.append("marionette section error: %s: %s" % (type(ex).__name__, ex))
+    finally:
+        if os.environ.get("GD_PASSKEY_TEST_FORCE_KILL") == "1":
+            print("TEST HOOK: SIGKILL browser group instead of quitting"); killgrp()
+        elif m is not None and p.poll() is None:
+            try:
+                with m.using_context("chrome"): m.execute_script("Services.startup.quit(Ci.nsIAppStartup.eAttemptQuit)")
+            except Exception as ex:
+                print("quit request raised (often normal as the connection drops): %s: %s" % (type(ex).__name__, ex))
+        try:
+            p.wait(30)
+        except subprocess.TimeoutExpired:
+            killed = True; fails.append("browser did not quit within 30s; process group killed")
+            killgrp()
+            try: p.wait(10)
+            except subprocess.TimeoutExpired: fails.append("browser still alive 10s after SIGKILL")
+        print(ARCH, "exit", p.returncode)
+        if p.returncode != 0 and not killed: fails.append("browser exited abnormally (%s)" % p.returncode)
+        time.sleep(1)
+        left = subprocess.run(["pgrep", "-fl", pd], capture_output=True, text=True).stdout.strip()
+        if left:
+            fails.append("processes left using the throwaway profile: %s" % left.replace("\n", " | "))
+            killgrp()
+        else: print("leftover processes on profile: none")
+print("READINESS RESULT", "PASS" if not fails else "FAIL", fails, flush=True)
 sys.exit(1 if fails else 0)
