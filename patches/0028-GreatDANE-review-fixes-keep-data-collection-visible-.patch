@@ -35,27 +35,28 @@ export const KNOWN_FPS = new Set([
 export const LEGACY_SUBJECTS = new Set(LEGACY_TLDS.map(t => `CN=${LEGACY_NAME} .${t} root CA`));
 
 // Pure: is this nsIX509Cert-like object one of the legacy PepeNet roots?
-export function isLegacyRoot(cert) {
+export function isLegacyRoot(cert, known = KNOWN_FPS) {
   if (!cert || cert.isBuiltInRoot) return false;
-  return LEGACY_SUBJECTS.has(cert.subjectName) && cert.issuerName === cert.subjectName;
+  return known.has(String(cert.sha256Fingerprint || "").toUpperCase()) &&
+    LEGACY_SUBJECTS.has(cert.subjectName) && cert.issuerName === cert.subjectName;
 }
 
 function certdb() {
   return Cc["@mozilla.org/security/x509certdb;1"].getService(Ci.nsIX509CertDB);
 }
 
-export function findLegacyRoots(db = certdb()) {
-  return db.getCerts().filter(isLegacyRoot);
+export function findLegacyRoots(db = certdb(), known = KNOWN_FPS) {
+  return db.getCerts().filter(c => isLegacyRoot(c, known));
 }
 
 // Removes exactly the given certs, re-checking each first.
-export function removeLegacyRoots(certs, db = certdb()) {
+export function removeLegacyRoots(certs, db = certdb(), known = KNOWN_FPS) {
   let removed = 0;
   for (let c of certs) {
-    if (!isLegacyRoot(c)) continue;
+    if (!isLegacyRoot(c, known)) continue;
     db.deleteCertificate(c);
     removed++;
-    log("removed", c.subjectName, c.sha256Fingerprint, KNOWN_FPS.has(c.sha256Fingerprint) ? "(known)" : "");
+    log("removed", c.subjectName, c.sha256Fingerprint);
   }
   return removed;
 }
