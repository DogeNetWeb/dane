+    def strip_line(line):
+        if _PREPROCESSOR_DIRECTIVE.match(line):
+            return line
+        in_str = False
+        i = 0
+        while i < len(line):
+            c = line[i]
+            if in_str:
+                if c == "\\" and i + 1 < len(line):
+                    i += 2
+                    continue
+                if c == '"':
+                    in_str = False
+                i += 1
+                continue
+            if c == '"':
