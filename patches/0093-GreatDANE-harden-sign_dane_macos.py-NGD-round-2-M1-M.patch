+# Dane macOS signing config: the single source of truth for the Apple Developer team ID.
+# Read by greatdane/tools/sign_dane_macos.py (plan/sign/check) and greatdane/tools/sign-only.sh.
+# sign-map.tsv and the entitlement plist headers refer to this file instead of repeating the ID.
+# Build-time copy that has to stay equal (checked by greatdane/tests/sign_dane_macos_selftest.py when present):
+#   build/moz.configure/update-programs.configure  certificate leaf[subject.OU]
+TEAM_ID=MNL79V994R
+BUNDLE_ID=surf.dogecoin.dane
