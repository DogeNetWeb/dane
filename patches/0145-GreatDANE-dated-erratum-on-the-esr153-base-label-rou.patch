 # Fallback: a minimal reimplementation that only accepts %define /
 # %include. Not a vendored copy of the preprocessor when falling back.
@@ -304,7 +306,7 @@ _PREPROCESSOR_CLS = None
 _PARSER_KIND = "minimal-reimplementation"
