+  let first = res.offset + 1, last = res.offset + LIMIT;
   let note = !pq ? "Not a valid name search." :
-    res.hosts.length ? `${res.hosts.length} name${res.hosts.length == 1 ? "" : "s"}` +
-      (pq.label ? "" : ` (up to ${LIMIT} per first letter; search to narrow)`) :
+    res.rows.length ? `${res.total} name${res.total == 1 ? "" : "s"}` + (res.total > LIMIT || res.offset ? ` (page ${first}–${Math.min(last, Math.max(res.total, first))} per chain)` : "") :
+    res.noDb.length && !res.failed.length && res.noDb.length == res.live.length ? "The node is still syncing; names appear once its database is ready." :
     res.live.length ? "No names found." : "No node is ready yet; names appear once it is running.";
-  let down = res.down.length ? `<p class="code">Not running: ${res.down.map(t => "." + esc(t)).join(", ")}</p>` : "";
