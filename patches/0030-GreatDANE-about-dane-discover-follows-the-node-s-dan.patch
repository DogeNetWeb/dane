-  }
-  return { hosts: collect(lists), live: live.map(c => c.tld), down: chains.filter(c => !c.ports).map(c => c.tld) };
+  let pages = await Promise.all(live.map(c => fetchPage(c.ports.pac, c.tld, pq.label, offset)));
+  let rows = pages.flatMap(p => p.rows).sort((a, b) => a.host.localeCompare(b.host));
+  return {
+    rows, hosts: rows.map(r => r.host), offset,
+    total: pages.reduce((n, p) => n + p.total, 0),
+    more: pages.some(p => offset + LIMIT < p.total),
+    truncated: pages.some(p => p.truncated),
+    noDb: pages.filter(p => p.status == "no_db").map(p => p.tld),
+    failed: pages.filter(p => p.status != "ok" && p.status != "no_db").map(p => p.tld),
+    live: live.map(c => c.tld), down: chains.filter(c => !c.ports).map(c => c.tld),
+  };
 }
 
 export function renderDiscover(rawQ, pq, res) {
-  let rows = res.hosts.map(h =>
-    `<li><a href="https://${esc(h)}/">${esc(h)}</a></li>`).join("");
+  res = { rows: [], offset: 0, total: 0, more: false, truncated: false, noDb: [], failed: [], live: [], down: [], ...res };
+  let rows = res.rows.map(r =>
