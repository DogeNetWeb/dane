+// One chain's /gd/names reply -> normalized page. Only well-formed rows survive.
+export function normalize(tld, j, httpStatus = 200) {
+  let st = (j && (j.status || j.error)) || (httpStatus == 200 ? "ok" : "error");
+  if (httpStatus != 200 || st != "ok") return { tld, status: st, rows: [], total: 0, count: 0, truncated: false };
+  let rows = [];
+  for (let n of Array.isArray(j.names) ? j.names : []) {
+    if (!n || typeof n != "object" || typeof n.name != "string" || !LABEL.test(n.name)) continue;
+    rows.push({
+      host: n.name + "." + tld,
+      owner: typeof n.owner_h160 == "string" && H160.test(n.owner_h160) ? n.owner_h160 : null,
+      expiry: Number.isFinite(n.lease_expiry) ? n.lease_expiry : 0,
