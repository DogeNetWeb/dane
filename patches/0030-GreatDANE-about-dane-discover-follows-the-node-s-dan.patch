+      fetch(`http://127.0.0.1:${port}/gd/names?prefix=${encodeURIComponent(prefix)}&offset=${offset}&limit=${LIMIT}`,
             { cache: "no-store" }),
       new Promise((_, rej) => lazy.setTimeout(() => rej(new Error("timeout")), 1500)),
     ]);
-    let j = await r.json();
-    return Array.isArray(j?.names) ? j.names : [];
+    let j = null;
+    try { j = await r.json(); } catch (e) {}
+    return normalize(tld, j, r.status);
   } catch (e) {
-    return [];
+    return { tld, status: "unreachable", rows: [], total: 0, count: 0, truncated: false };
   }
 }
 
-export async function lookup(pq, chains = [...(lazy.GreatDANE._chains?.values() ?? [])]) {
