+    res.down.length ? `<p class="code">Not running: ${res.down.map(t => "." + esc(t)).join(", ")}</p>` : "",
+  ].join("");
+  let down = extra + (nav ? `<p id="nav">${nav}</p>` : "");
   return `<!DOCTYPE html><html><head><meta charset="utf-8">
