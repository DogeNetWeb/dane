   }
-  return [...out].sort((a, b) => a.localeCompare(b));
+  let total = Number.isInteger(j.total) && j.total >= 0 ? j.total : rows.length;
+  return { tld, status: "ok", rows, total, count: Number.isInteger(j.count) ? j.count : rows.length,
+           truncated: j.truncated === true };
 }
 
-async function fetchNames(port, prefix) {
