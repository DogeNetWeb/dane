 const esc = s => String(s ?? "").replace(/[&<>"']/g, ch => "&#" + ch.charCodeAt(0) + ";");
 
 // "foo", "foo.pe", "foo.pepe" -> { label, suffix }; null if not searchable.
+// The node's prefix is capped at 32 chars, so longer labels aren't searchable.
 export function parseQuery(q) {
   q = String(q ?? "").trim().toLowerCase().replace(/^https?:\/\//, "").replace(/[/.]+$/, "");
   if (!q) return { label: "", suffix: null };
   let [label, suffix = null, extra] = q.split(".");
-  if (extra !== undefined || !LABEL.test(label)) return null;
+  if (extra !== undefined || !LABEL.test(label) || !PREFIX.test(label)) return null;
