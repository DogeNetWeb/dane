diff --git a/browser/components/greatdane/test/marionette/run_gd_discover.py b/browser/components/greatdane/test/marionette/run_gd_discover.py
new file mode 100644
index 0000000000..23551afab5
--- /dev/null
+++ b/browser/components/greatdane/test/marionette/run_gd_discover.py
@@ -0,0 +1,98 @@
+# about:dane-discover client vs. the node's dane-09 /gd/names contract, in the
+# built Dane (chrome context via Marionette). Mock nodes are local Python HTTP
+# servers on ephemeral loopback ports: paging (offset/total), 503 no_db,
+# truncated, null owner_h160, malformed rows, chain-down.
+#   python3 run_gd_discover.py [path/to/greatdane]
+import json, os, shutil, subprocess, sys, tempfile, threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from urllib.parse import urlparse, parse_qs
+from marionette_driver.marionette import Marionette
+HERE = os.path.dirname(os.path.abspath(__file__))
+TREE = os.path.abspath(os.path.join(HERE, "../../../../.."))
+APP = sys.argv[1] if len(sys.argv) > 1 else TREE + "/obj-gd/dist/Dane.app/Contents/MacOS/greatdane"
+H = "ab" * 20
+ALL = [{"name": "dn%03d" % i, "owner_h160": None if i % 2 else H, "lease_expiry": 777, "state": 1, "price": 0}
+       for i in range(45)]
+
+def mock(fn):
+    class Hd(BaseHTTPRequestHandler):
+        def log_message(self, *a): pass
+        def do_GET(self):
+            u = urlparse(self.path); q = {k: v[0] for k, v in parse_qs(u.query, keep_blank_values=True).items()}
+            code, body = fn(q) if u.path == "/gd/names" else (404, {"status": "not_found"})
+            b = json.dumps(body).encode(); self.send_response(code)
+            self.send_header("Content-Type", "application/json"); self.send_header("Content-Length", str(len(b)))
+            self.end_headers(); self.wfile.write(b)
+    s = ThreadingHTTPServer(("127.0.0.1", 0), Hd); threading.Thread(target=s.serve_forever, daemon=True).start()
+    return s.server_address[1]
+
+def paged(q):
+    o, l = int(q.get("offset", 0)), int(q.get("limit", 20)); rows = ALL[o:o + l]
+    return 200, {"tld": "pepe", "status": "ok", "prefix": q.get("prefix", ""), "names": rows, "total": len(ALL),
+                 "offset": o, "limit": l, "count": len(rows), "truncated": False}
+PEP = mock(paged)
+DOGE = mock(lambda q: (503, {"tld": "doge", "status": "no_db"}))
+TRUNC = mock(lambda q: (200, {"tld": "pepe", "status": "ok", "names": ALL[:3] + [{"name": "Bad Name"}, "str", None,
+                               {"name": "zz", "owner_h160": "xyz"}], "total": 4, "count": 4, "truncated": True}))
+
+prof = tempfile.mkdtemp(prefix="gd-disc-")
+open(prof + "/user.js", "w").write('user_pref("marionette.port", 2834);\nuser_pref("browser.aboutwelcome.enabled", false);\n'
+    'user_pref("greatdane.legacy.certCleanup", false);\nuser_pref("greatdane.legacy.import", false);\n')
+p = subprocess.Popen([APP, "--headless", "--marionette", "-remote-allow-system-access", "--no-remote", "--profile", prof],
+                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+fails = 0
+def check(name, ok, info=""):
+    global fails
+    print(("PASS " if ok else "FAIL ") + name + (f"  [{info}]" if info and not ok else ""))
+    fails += 0 if ok else 1
+rc = 1
+try:
+    m = Marionette(host="127.0.0.1", port=2834); m.start_session()
+    with m.using_context("chrome"):
+        r = m.execute_async_script('''let [pep, doge, trunc, done] = arguments;
+          (async () => { try {
+          const D = ChromeUtils.importESModule("resource:///modules/GreatDANEDiscover.sys.mjs");
+          const all = { label: "", suffix: null };
+          let chains = [{ tld: "pepe", ports: { pac: pep } }, { tld: "doge", ports: { pac: doge } }, { tld: "zz", ports: null }];
+          let o = {};
+          let r0 = await D.lookup(all, chains, 0), h0 = D.renderDiscover("", all, r0);
+          o.p0 = [r0.rows.length, r0.total, r0.more, r0.noDb, r0.down, r0.rows[1].owner, r0.rows[0].owner,
+                  h0.includes('id="next"'), h0.includes('id="prev"'), h0.includes("unowned"), h0.includes("Still syncing: .doge")];
+          let r2 = await D.lookup(all, chains, 40), h2 = D.renderDiscover("", all, r2);
+          o.p2 = [r2.rows.length, r2.more, h2.includes('id="prev"'), h2.includes('id="next"'), r2.rows[0].host];
+          let dq = { label: "", suffix: "do" }, r3 = await D.lookup(dq, chains, 0);
+          o.nodb = [r3.rows.length, r3.noDb, D.renderDiscover("", dq, r3).includes("still syncing")];
+          let tq = { label: "dn", suffix: null }, r4 = await D.lookup(tq, [{ tld: "pepe", ports: { pac: trunc } }], 0);
+          o.trunc = [r4.truncated, r4.rows.map(x => x.host), r4.rows.map(x => x.owner),
+                     D.renderDiscover("dn", tq, r4).includes('id="truncated"')];
+          o.parse = [D.parseOffset("-1"), D.parseOffset("x"), D.parseOffset("40"), D.parseQuery("x".repeat(33)),
+                     JSON.stringify(D.parseQuery("Foo.PE")), D.parseQuery("a.b.c")];
+          done(o); } catch (e) { done({ err: String(e) + e.stack }); } })();''',
+          script_args=[PEP, DOGE, TRUNC], sandbox=None, script_timeout=30000)
+    if "err" in r: check("script ran", False, r["err"])
+    else:
+        p0 = r["p0"]
+        check("page 1: 20 rows of total 45, more", p0[:3] == [20, 45, True], p0)
+        check("no_db chain reported, down chain listed", p0[3] == ["doge"] and p0[4] == ["zz"], p0)
+        check("null owner_h160 -> unowned, hex kept", p0[5] is None and p0[6] == "ab" * 20 and p0[9], p0)
+        check("page 1 has Next, no Previous", p0[7] and not p0[8], p0)
+        check("syncing chain noted beside results", p0[10], p0)
+        p2 = r["p2"]
+        check("offset 40: last 5 rows, Previous only", p2[:4] == [5, False, True, False] and p2[4] == "dn040.pepe", p2)
+        check("all chains no_db -> 'still syncing'", r["nodb"] == [0, ["doge"], True], r["nodb"])
+        t = r["trunc"]
+        check("truncated surfaced", t[0] and t[3], t)
+        check("malformed rows dropped, bad owner -> null", t[1] == ["dn000.pepe", "dn001.pepe", "dn002.pepe", "zz.pepe"]
+              and t[2] == [H, None, H, None], t)
+        pr = r["parse"]
+        check("offset/query parsing bounded", pr[:4] == [0, 0, 40, None] and pr[4] == '{"label":"foo","suffix":"pe"}'
+              and pr[5] is None, pr)
+    with m.using_context("chrome"):
+        m.execute_script("Services.startup.quit(Ci.nsIAppStartup.eAttemptQuit)")
+    rc = 0 if fails == 0 else 1
+finally:
+    try: p.wait(20)
+    except Exception: p.terminate(); p.wait(20)
+    shutil.rmtree(prof, ignore_errors=True)
+print(f"failed={fails}")
+sys.exit(rc)
