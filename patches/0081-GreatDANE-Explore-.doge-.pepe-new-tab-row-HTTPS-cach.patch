diff --git a/browser/components/greatdane/GreatDANEExplore.sys.mjs b/browser/components/greatdane/GreatDANEExplore.sys.mjs
new file mode 100644
index 0000000000..fd1ee0bb58
--- /dev/null
+++ b/browser/components/greatdane/GreatDANEExplore.sys.mjs
@@ -0,0 +1,277 @@
+/* GreatDANE: Explore .doge & .pepe — HTTPS-live name cache for the new-tab
+ * "Explore .doge & .pepe" row. Candidates come from each node's loopback
+ * /gd/names (same as about:dane-discover). Inclusion requires a real HTTPS
+ * fetch through Dane's normal proxy + DANE-EE TLSA/pin path (no bypass, no
+ * loopback-"likely live" substitution). Results are cached on disk; callers
+ * must never trigger a probe merely because about:newtab opened.
+ *
+ * Privacy: a refresh contacts the probed sites from this browser's network
+ * path (node proxy to the site). That is not IP-private. Prefer a future
+ * session-external curated list if product wants zero per-browser probes.
+ */
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  GreatDANE: "resource:///modules/GreatDANE.sys.mjs",
+  lookup: "resource:///modules/GreatDANEDiscover.sys.mjs",
+  parseQuery: "resource:///modules/GreatDANEDiscover.sys.mjs",
+  setTimeout: "resource://gre/modules/Timer.sys.mjs",
+  clearTimeout: "resource://gre/modules/Timer.sys.mjs",
+});
+
+export const PREF_ENABLED = "greatdane.explore.enabled";
+export const PREF_TTL = "greatdane.explore.ttlSeconds";
+export const PREF_MAX = "greatdane.explore.maxTiles";
+export const PREF_PROBE_TIMEOUT = "greatdane.explore.probeTimeoutMs";
+export const PREF_CANDIDATE_LIMIT = "greatdane.explore.candidateLimit";
+export const CACHE_FILENAME = "greatdane-explore-cache.json";
+
+export const DEFAULT_TTL_SECONDS = 6 * 60 * 60; // 6h
+export const DEFAULT_MAX_TILES = 8;
+export const DEFAULT_PROBE_TIMEOUT_MS = 8000;
+export const DEFAULT_CANDIDATE_LIMIT = 40;
+
+const LABEL = /^[a-z0-9-]{1,63}$/;
+
+function prefBool(name, fallback) {
+  try {
+    return Services.prefs.getBoolPref(name, fallback);
+  } catch (e) {
+    return fallback;
+  }
+}
+function prefInt(name, fallback) {
+  try {
+    return Services.prefs.getIntPref(name, fallback);
+  } catch (e) {
+    return fallback;
+  }
+}
+
+function cachePath() {
+  return PathUtils.join(PathUtils.localProfileDir, CACHE_FILENAME);
+}
+
+/** @returns {Promise<{checkedAt:number, ttlSeconds:number, live:Array<{host:string,url:string,title:string,status:number}>}>} */
+export async function readCache() {
+  try {
+    let data = await IOUtils.readJSON(cachePath());
+    if (!data || typeof data != "object") {
+      return emptyCache();
+    }
+    let live = Array.isArray(data.live) ? data.live.filter(validLiveRow) : [];
+    return {
+      checkedAt: Number.isFinite(data.checkedAt) ? data.checkedAt : 0,
+      ttlSeconds: Number.isFinite(data.ttlSeconds) ? data.ttlSeconds : DEFAULT_TTL_SECONDS,
+      live,
+    };
+  } catch (e) {
+    if (!(e instanceof DOMException) || e.name !== "NotFoundError") {
+      console.warn("GreatDANE Explore: cache read failed", e);
+    }
+    return emptyCache();
+  }
+}
+
+function emptyCache() {
+  return { checkedAt: 0, ttlSeconds: DEFAULT_TTL_SECONDS, live: [] };
+}
+
+function validLiveRow(row) {
+  return (
+    row &&
+    typeof row == "object" &&
+    typeof row.host == "string" &&
+    LABEL.test(row.host.split(".")[0]) &&
+    typeof row.url == "string" &&
+    row.url.startsWith("https://")
+  );
+}
+
+export async function writeCache(cache) {
+  let payload = {
+    checkedAt: cache.checkedAt || Date.now(),
+    ttlSeconds: cache.ttlSeconds || prefInt(PREF_TTL, DEFAULT_TTL_SECONDS),
+    live: (cache.live || []).filter(validLiveRow),
+    // Explicit privacy note for anyone reading the file on disk.
+    privacy:
+      "Refresh probes contact listed hosts from this browser (via Dane node proxy). Not IP-private.",
+  };
+  await IOUtils.writeJSON(cachePath(), payload, { tmpPath: cachePath() + ".tmp" });
+  return payload;
+}
+
+export function isFresh(cache, now = Date.now()) {
+  let ttl = Math.max(
+    60,
+    Number(cache?.ttlSeconds) || prefInt(PREF_TTL, DEFAULT_TTL_SECONDS)
+  );
+  let at = Number(cache?.checkedAt) || 0;
+  return at > 0 && now - at < ttl * 1000;
+}
+
+/** List candidate https://host/ URLs from loopback /gd/names (not a liveness claim). */
+export async function listCandidates(limit = prefInt(PREF_CANDIDATE_LIMIT, DEFAULT_CANDIDATE_LIMIT)) {
+  let pq = lazy.parseQuery("");
+  let res = await lazy.lookup(pq);
+  let hosts = [];
+  let seen = new Set();
+  for (let row of res.rows || []) {
+    let host = String(row.host || "").toLowerCase();
+    if (!host || seen.has(host)) continue;
+    // Skip bare TLD-only if any slip through.
+    if (!host.includes(".")) continue;
+    seen.add(host);
+    hosts.push(host);
+    if (hosts.length >= limit) break;
+  }
+  return hosts.map(host => ({
+    host,
+    url: "https://" + host + "/",
+    title: host,
+  }));
+}
+
+/**
+ * Probe one HTTPS URL through Dane's normal stack. Resolves with
+ * {ok, status, host, url, title} — ok only when TLS+HTTP completed without
+ * throw and status is 2xx/3xx/4xx (server answered). 5xx and network/TLS
+ * failures are not ok (hidden from the row).
+ */
+export async function probeHttps(url, timeoutMs = prefInt(PREF_PROBE_TIMEOUT, DEFAULT_PROBE_TIMEOUT_MS)) {
+  let host;
+  try {
+    host = Services.io.newURI(url).host.toLowerCase();
+  } catch (e) {
+    return { ok: false, status: 0, host: "", url, title: "" };
+  }
+  if (!lazy.GreatDANE._chainFor(host)) {
+    return { ok: false, status: 0, host, url, title: host };
+  }
+  let ctrl = new AbortController();
+  let timer = lazy.setTimeout(() => ctrl.abort(), Math.max(500, timeoutMs));
+  try {
+    let resp = await fetch(url, {
+      method: "GET",
+      redirect: "follow",
+      cache: "no-store",
+      credentials: "omit",
+      signal: ctrl.signal,
+      // System principal fetch does not record Places visits.
+    });
+    let status = resp.status || 0;
+    // Consuming a little body avoids some keep-alive edge cases; ignore errors.
+    try {
+      await resp.arrayBuffer();
+    } catch (e) {}
+    let ok = status >= 200 && status < 500;
+    return { ok, status, host, url: "https://" + host + "/", title: host };
+  } catch (e) {
+    return { ok: false, status: 0, host, url: "https://" + host + "/", title: host };
+  } finally {
+    lazy.clearTimeout(timer);
+  }
+}
+
+/**
+ * Refresh cache: candidate list from loopback directory, then HTTPS probes
+ * until maxTiles successes or candidates exhausted. Always rewrites checkedAt
+ * so a total failure still backs off for TTL (empty row, not tight retry loop).
+ */
+export async function refreshCache({
+  maxTiles = prefInt(PREF_MAX, DEFAULT_MAX_TILES),
+  candidateLimit = prefInt(PREF_CANDIDATE_LIMIT, DEFAULT_CANDIDATE_LIMIT),
+  ttlSeconds = prefInt(PREF_TTL, DEFAULT_TTL_SECONDS),
+} = {}) {
+  if (!prefBool(PREF_ENABLED, true)) {
+    return writeCache({ checkedAt: Date.now(), ttlSeconds, live: [] });
+  }
+  let candidates = await listCandidates(candidateLimit);
+  let live = [];
+  for (let c of candidates) {
+    if (live.length >= maxTiles) break;
+    let result = await probeHttps(c.url);
+    if (result.ok) {
+      live.push({
+        host: result.host,
+        url: result.url,
+        title: result.title,
+        status: result.status,
+      });
+    }
+  }
+  return writeCache({ checkedAt: Date.now(), ttlSeconds, live });
+}
+
+/** Cache rows shaped for Activity Stream section cards. No Places fields. */
+export function rowsFromCache(cache) {
+  return (cache?.live || []).filter(validLiveRow).map((row, i) => ({
+    url: row.url,
+    hostname: row.host,
+    title: row.title || row.host,
+    type: "history",
+    // Fake guid so Card keys are stable; not a Places guid.
+    guid: "dane-explore-" + row.host,
+    hasImage: false,
+    // Tip for UI: not Places / not sponsored.
+    description: ".doge / .pepe",
+  }));
+}
+
+let _refreshInFlight = null;
+let _scheduled = null;
+
+/** Return live rows from cache; optionally kick a background refresh if stale. */
+export async function getExploreRows({ allowRefresh = true } = {}) {
+  if (!prefBool(PREF_ENABLED, true)) {
+    return [];
+  }
+  let cache = await readCache();
+  if (allowRefresh && !isFresh(cache)) {
+    scheduleRefresh();
+  }
+  return rowsFromCache(cache);
+}
+
+export function scheduleRefresh(delayMs = 0) {
+  if (!prefBool(PREF_ENABLED, true)) return;
+  if (_refreshInFlight) return;
+  if (_scheduled) {
+    lazy.clearTimeout(_scheduled);
+    _scheduled = null;
+  }
+  _scheduled = lazy.setTimeout(() => {
+    _scheduled = null;
+    if (_refreshInFlight) return;
+    _refreshInFlight = refreshCache()
+      .catch(e => console.warn("GreatDANE Explore: refresh failed", e))
+      .finally(() => {
+        _refreshInFlight = null;
+      });
+  }, Math.max(0, delayMs));
+}
+
+export function exploreEnabled() {
+  return prefBool(PREF_ENABLED, true);
+}
+
+export const GreatDANEExplore = {
+  PREF_ENABLED,
+  PREF_TTL,
+  PREF_MAX,
+  PREF_PROBE_TIMEOUT,
+  PREF_CANDIDATE_LIMIT,
+  CACHE_FILENAME,
+  DEFAULT_TTL_SECONDS,
+  DEFAULT_MAX_TILES,
+  readCache,
+  writeCache,
+  isFresh,
+  listCandidates,
+  probeHttps,
+  refreshCache,
+  rowsFromCache,
+  getExploreRows,
+  scheduleRefresh,
+  exploreEnabled,
+};
