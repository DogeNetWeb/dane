+/* GreatDANE Explore: pure helpers (freshness + row shaping). */
+"use strict";
+
+const { isFresh, rowsFromCache, DEFAULT_TTL_SECONDS } = ChromeUtils.importESModule(
+  "resource:///modules/GreatDANEExplore.sys.mjs"
+);
+
+add_task(function test_isFresh_ttl() {
+  let now = 1_700_000_000_000;
+  Assert.ok(!isFresh({ checkedAt: 0, ttlSeconds: 100 }, now));
+  Assert.ok(
+    isFresh({ checkedAt: now - 1000, ttlSeconds: 10 }, now),
+    "within TTL"
+  );
+  Assert.ok(
+    !isFresh({ checkedAt: now - 11_000, ttlSeconds: 10 }, now),
+    "past TTL"
+  );
+  Assert.equal(DEFAULT_TTL_SECONDS, 6 * 60 * 60);
+});
+
+add_task(function test_rowsFromCache_filters_and_shapes() {
+  let rows = rowsFromCache({
+    live: [
+      { host: "alpha.doge", url: "https://alpha.doge/", title: "alpha.doge", status: 200 },
+      { host: "bad", url: "http://nope/", title: "x" }, // not https
+      null,
+      { host: "beta.pepe", url: "https://beta.pepe/", title: "beta.pepe", status: 301 },
+    ],
+  });
+  Assert.equal(rows.length, 2);
+  Assert.equal(rows[0].url, "https://alpha.doge/");
+  Assert.equal(rows[0].guid, "dane-explore-alpha.doge");
+  Assert.equal(rows[0].type, "history");
+  Assert.ok(!rows[0].bookmarkGuid);
+  Assert.equal(rows[1].hostname, "beta.pepe");
+});
