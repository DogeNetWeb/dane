diff --git a/browser/extensions/newtab/lib/GreatDANEExploreFeed.sys.mjs b/browser/extensions/newtab/lib/GreatDANEExploreFeed.sys.mjs
new file mode 100644
index 0000000000..4676cce2ef
--- /dev/null
+++ b/browser/extensions/newtab/lib/GreatDANEExploreFeed.sys.mjs
@@ -0,0 +1,120 @@
+/* GreatDANE: Activity Stream feed for the Explore .doge & .pepe section.
+ * Displays HTTPS-validated chain sites from GreatDANEExplore's disk cache.
+ * Never probes on about:newtab open; stale caches schedule a background
+ * refresh. Does not read or write Places. */
+
+const lazy = {};
+ChromeUtils.defineESModuleGetters(lazy, {
+  SectionsManager: "resource://newtab/lib/SectionsManager.sys.mjs",
+  GreatDANEExplore: "resource:///modules/GreatDANEExplore.sys.mjs",
+});
+
+import { actionTypes as at } from "resource://newtab/common/Actions.mjs";
+
+export const SECTION_ID = "daneexplore";
+
+export class GreatDANEExploreFeed {
+  constructor() {
+    this._observing = false;
+  }
+
+  init() {
+    lazy.SectionsManager.onceInitialized(this.postInit.bind(this));
+  }
+
+  postInit() {
+    this._ensurePrefObserver();
+    if (!lazy.GreatDANEExplore.exploreEnabled()) {
+      lazy.SectionsManager.disableSection(SECTION_ID);
+      return;
+    }
+    lazy.SectionsManager.enableSection(SECTION_ID, true /* isStartup */);
+    this.publishRows({ broadcast: true, isStartup: true, allowRefresh: true });
+  }
+
+  uninit() {
+    if (this._observing) {
+      try {
+        Services.prefs.removeObserver(
+          lazy.GreatDANEExplore.PREF_ENABLED,
+          this
+        );
+      } catch (e) {}
+      this._observing = false;
+    }
+    lazy.SectionsManager.disableSection(SECTION_ID);
+  }
+
+  _ensurePrefObserver() {
+    if (this._observing) return;
+    try {
+      Services.prefs.addObserver(lazy.GreatDANEExplore.PREF_ENABLED, this);
+      this._observing = true;
+    } catch (e) {
+      console.warn("GreatDANE Explore feed: pref observer failed", e);
+    }
+  }
+
+  observe(subject, topic, data) {
+    if (topic !== "nsPref:changed") return;
+    if (data === lazy.GreatDANEExplore.PREF_ENABLED) {
+      this._onEnabledChanged();
+    }
+  }
+
+  _onEnabledChanged() {
+    if (lazy.GreatDANEExplore.exploreEnabled()) {
+      lazy.SectionsManager.enableSection(SECTION_ID);
+      this.publishRows({ broadcast: true, allowRefresh: true });
+    } else {
+      lazy.SectionsManager.disableSection(SECTION_ID);
+    }
+  }
+
+  async publishRows({
+    broadcast = false,
+    isStartup = false,
+    allowRefresh = false,
+  } = {}) {
+    if (!lazy.GreatDANEExplore.exploreEnabled()) {
+      lazy.SectionsManager.updateSection(
+        SECTION_ID,
+        { rows: [] },
+        true,
+        isStartup
+      );
+      return;
+    }
+    let rows = await lazy.GreatDANEExplore.getExploreRows({ allowRefresh });
+    const section = this.store
+      .getState()
+      .Sections.find(s => s.id === SECTION_ID);
+    const initialized = section && section.initialized;
+    const shouldBroadcast = broadcast || !initialized;
+    lazy.SectionsManager.updateSection(
+      SECTION_ID,
+      { rows },
+      shouldBroadcast,
+      isStartup
+    );
+  }
+
+  onAction(action) {
+    switch (action.type) {
+      case at.INIT:
+        this.init();
+        break;
+      case at.UNINIT:
+        this.uninit();
+        break;
+      case at.SYSTEM_TICK:
+        // May schedule a background refresh if cache is stale; paint is cache-only.
+        this.publishRows({ allowRefresh: true });
+        break;
+      case at.NEW_TAB_LOAD:
+        // Cache only — never probe because a new tab opened.
+        this.publishRows({ allowRefresh: false });
+        break;
+    }
+  }
+}
