+// Seconds to wait before retrying a GD_ZONE_LOADING interstitial.
+// Honors Retry-After (seconds) or retry_ms, clamped to the 10s budget,
+// at least 1s so the page cannot tight-loop.
+export function loadingRetrySec({ retryAfter, retryMs } = {}) {
+  let sec;
+  let ms = Number(retryMs);
+  let ra = Number(retryAfter);
+  if (Number.isFinite(ms) && ms >= 1) sec = Math.max(1, Math.ceil(ms / 1000));
+  else if (Number.isFinite(ra) && ra >= 1) sec = Math.floor(ra);
+  else sec = 1; // node proxy sends Retry-After: 1
+  let cap = 10;
+  try { cap = lazyTimeoutSec(); } catch (e) {}
+  if (sec > cap) sec = cap;
+  if (sec < 1) sec = 1;
+  return sec;
+}
+
+// A cold CONNECT through the node's PAC proxy waits, then returns
+// 503 + Retry-After: 1 + X-GreatDANE-Status: loading. That is
+// retryable, not a generic network/cert error.
+export function proxyLoadingFromRequest(request) {
+  if (!request) return { loading: false, retryAfter: null, httpStatus: 0 };
+  let status = 0, gd = "", ra = "";
+  try {
+    let ch = request.QueryInterface(Ci.nsIHttpChannel);
+    try { status = ch.responseStatus; } catch (e) {}
+    try { gd = ch.getResponseHeader("X-GreatDANE-Status"); } catch (e) {}
+    try { ra = ch.getResponseHeader("Retry-After"); } catch (e) {}
+  } catch (e) {
+    return { loading: false, retryAfter: null, httpStatus: 0 };
+  }
+  let loading = String(gd).trim().toLowerCase() == "loading";
+  let retryAfter = null;
+  let n = parseInt(ra, 10);
+  if (Number.isInteger(n) && n >= 1) retryAfter = n;
+  return { loading, retryAfter, httpStatus: status };
+}
