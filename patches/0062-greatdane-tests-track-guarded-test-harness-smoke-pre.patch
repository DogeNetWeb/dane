diff --git a/greatdane/tests/README.md b/greatdane/tests/README.md
new file mode 100644
index 0000000000..6bba388068
--- /dev/null
+++ b/greatdane/tests/README.md
@@ -0,0 +1,5 @@
+# Dane test harness
+All scripts import `greatdane/tools/gd_guard.py` first: it aborts if nowon's real
+GreatDANE profiles.ini/installs.ini change, and gives throwaway profile/node-data dirs.
+Run with the marionette venv, e.g.
+`/Volumes/Storage/build/greatdane/mn-venv/bin/python smoke.py <Dane.app/Contents/MacOS/greatdane> arm64`
diff --git a/greatdane/tests/gmp_check.py b/greatdane/tests/gmp_check.py
new file mode 100644
index 0000000000..23f469c756
--- /dev/null
+++ b/greatdane/tests/gmp_check.py
@@ -0,0 +1,64 @@
+# GMP check: download/activate Widevine + OpenH264 via the GMP manager, then
+# Widevine: MediaKeys + license-request message from the CDM; ClearKey: full EME session (license accepted);
+# OpenH264: H.264-only WebRTC loopback, frames decoded.
+import os as _os, sys as _sys; _sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), "..", "tools"))
+import gd_guard  # must be first: real-profile guard + throwaway dirs
+import sys, subprocess, tempfile, time, json, os
+from marionette_driver.marionette import Marionette
+APP, ARCH = sys.argv[1], sys.argv[2]
+prof = gd_guard.profile("gd-test-")
+open(prof+"/user.js","w").write('''user_pref("marionette.port", 2838);
+user_pref("greatdane.node.dataDir", "' + gd_guard.ND + '");\nuser_pref("greatdane.pep.listen_port", 34874);\nuser_pref("greatdane.doge.listen_port", 23556);\nuser_pref("greatdane.legacy.certCleanup", false);
+user_pref("greatdane.legacy.import", false);
+user_pref("browser.shell.checkDefaultBrowser", false);
+user_pref("media.eme.enabled", true);
+user_pref("media.navigator.permission.disabled", true);
+user_pref("media.peerconnection.ice.loopback", true);
+user_pref("media.peerconnection.ice.obfuscate_host_addresses", false);
+''')
+p = subprocess.Popen(["arch","-"+ARCH,APP,"-marionette","-remote-allow-system-access","-no-remote","-profile",prof],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+m = Marionette(host="127.0.0.1", port=2838); m.start_session(); m.timeout.script = 240
+res = {"arch": ARCH}
+with m.using_context("chrome"):
+    res["install"] = m.execute_async_script("""const done=arguments[arguments.length-1];
+      const {GMPInstallManager}=ChromeUtils.importESModule("resource://gre/modules/GMPInstallManager.sys.mjs");
+      new GMPInstallManager().simpleCheckAndInstall().then(r=>done({ok:true,r:JSON.stringify(r).slice(0,200)}),e=>done({ok:false,err:String(e&&e.message||e)}));""")
+    t0=time.time()
+    while time.time()-t0 < 120:
+        v = m.execute_script("const g=n=>Services.prefs.getStringPref('media.'+n+'.version','');return {widevine:g('gmp-widevinecdm'),openh264:g('gmp-gmpopenh264'),abi:Services.appinfo.XPCOMABI}")
+        if v["widevine"] and v["openh264"]: break
+        time.sleep(3)
+    res["versions"] = v
+m.navigate("file://"+os.path.expanduser("~/gd-pending/gmp_test.html"))
+res["widevine"] = m.execute_async_script(r"""const done=arguments[arguments.length-1];
+ const pssh=Uint8Array.from(atob('AAAAW3Bzc2gAAAAA7e+LqXnWSs6jyCfc1R0h7QAAADsIARIQ62dqu8s0Xpa7z2FmMPGj2hoNd2lkZXZpbmVfdGVzdCIQZmtqM2xqYVNkZmFsa3IzaioCSEQyAA=='),c=>c.charCodeAt(0));
+ navigator.requestMediaKeySystemAccess('com.widevine.alpha',[{initDataTypes:['cenc'],videoCapabilities:[{contentType:'video/mp4; codecs="avc1.42E01E"'}]}])
+ .then(a=>a.createMediaKeys()).then(k=>{const s=k.createSession(); const to=setTimeout(()=>done({ok:false,err:'no message in 30s'}),30000);
+   s.addEventListener('message',e=>{clearTimeout(to);done({ok:true,messageType:e.messageType,bytes:e.message.byteLength});});
+   return s.generateRequest('cenc',pssh);}).catch(e=>done({ok:false,err:String(e)}));""")
+res["clearkey"] = m.execute_async_script(r"""const done=arguments[arguments.length-1];
+ const b64u=a=>btoa(String.fromCharCode(...a)).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'');
+ const kid=new Uint8Array(16).fill(1), key=new Uint8Array(16).fill(2);
+ const init=new TextEncoder().encode(JSON.stringify({kids:[b64u(kid)]}));
+ navigator.requestMediaKeySystemAccess('org.w3.clearkey',[{initDataTypes:['keyids'],videoCapabilities:[{contentType:'video/mp4; codecs="avc1.42E01E"'}]}])
+ .then(a=>a.createMediaKeys()).then(k=>{const s=k.createSession();
+   s.addEventListener('message',e=>{const lic=new TextEncoder().encode(JSON.stringify({keys:[{kty:'oct',kid:b64u(kid),k:b64u(key)}]}));
+     s.update(lic).then(()=>{const st=[];s.keyStatuses.forEach(v=>st.push(v));done({ok:st[0]==='usable',keyStatuses:st});}).catch(e=>done({ok:false,err:String(e)}));});
+   return s.generateRequest('keyids',init);}).catch(e=>done({ok:false,err:String(e)}));""")
+res["openh264"] = m.execute_async_script(r"""const done=arguments[arguments.length-1];
+ const c=document.getElementById('c'),g=c.getContext('2d');let f=0;setInterval(()=>{g.fillStyle='hsl('+(f++*15)+',80%,50%)';g.fillRect(0,0,320,240);g.fillStyle='#000';g.fillText(f,10,20);},33);
+ const st=c.captureStream(30), a=new RTCPeerConnection(), b=new RTCPeerConnection();
+ const gw=pc=>pc.iceGatheringState==='complete'?Promise.resolve():new Promise(r=>pc.addEventListener('icegatheringstatechange',()=>pc.iceGatheringState==='complete'&&r()));
+ const tr=a.addTransceiver(st.getVideoTracks()[0],{direction:'sendonly',streams:[st]});
+ const h=RTCRtpSender.getCapabilities('video').codecs.filter(x=>x.mimeType==='video/H264');
+ if(!h.length) return done({ok:false,err:'no H264 in sender capabilities'});
+ tr.setCodecPreferences(h);
+ (async()=>{await a.setLocalDescription(); await gw(a); await b.setRemoteDescription(a.localDescription); await b.setLocalDescription(); await gw(b); await a.setRemoteDescription(b.localDescription);
+  await new Promise(r=>setTimeout(r,8000)); const s=await b.getStats(); let fd=0,codec='';
+  window.__types=[];s.forEach(r=>window.__types.push(r.type+':'+(r.kind||'')));s.forEach(r=>{if(r.type==='inbound-rtp'&&r.kind==='video'){fd=r.framesDecoded;window.__dec=r.decoderImplementation;const cc=s.get(r.codecId);codec=cc&&cc.mimeType;}});
+  const os=await a.getStats();let enc='';os.forEach(r=>{if(r.type==='outbound-rtp')enc=r.encoderImplementation;});done({ok:fd>0&&codec==='video/H264',framesDecoded:fd,codec,decoder:window.__dec,encoder:enc,ice:a.iceConnectionState+'/'+b.iceConnectionState,types:window.__types.join(',')});})().catch(e=>done({ok:false,err:String(e)}));""")
+print(json.dumps(res))
+try:
+    with m.using_context("chrome"): m.execute_script("Services.startup.quit(Ci.nsIAppStartup.eAttemptQuit)")
+except Exception: pass
+p.wait(30)
diff --git a/greatdane/tests/hr_check.py b/greatdane/tests/hr_check.py
new file mode 100644
index 0000000000..56c8f6eb25
--- /dev/null
+++ b/greatdane/tests/hr_check.py
@@ -0,0 +1,34 @@
+# Hardened-runtime check: JS JIT, wasm, video encode+decode+play, on given arch.
+import os as _os, sys as _sys; _sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), "..", "tools"))
+import gd_guard  # must be first: real-profile guard + throwaway dirs
+import sys, subprocess, tempfile, time
+from marionette_driver.marionette import Marionette
+APP, ARCH = sys.argv[1], sys.argv[2]
+prof = gd_guard.profile("gd-test-")
+open(prof+"/user.js","w").write('user_pref("marionette.port", 2838);\nuser_pref("greatdane.node.dataDir", "' + gd_guard.ND + '");\nuser_pref("greatdane.pep.listen_port", 34874);\nuser_pref("greatdane.doge.listen_port", 23556);\nuser_pref("greatdane.legacy.certCleanup", false);\nuser_pref("greatdane.legacy.import", false);\nuser_pref("browser.shell.checkDefaultBrowser", false);\nuser_pref("media.autoplay.default", 0);\n')
+p = subprocess.Popen(["arch","-"+ARCH,APP,"-marionette","-remote-allow-system-access","-no-remote","-profile",prof],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+m = Marionette(host="127.0.0.1", port=2838); m.start_session()
+m.navigate("data:text/html,<title>hr</title><canvas id=c width=64 height=64></canvas>")
+m.timeout.script = 60
+r = m.execute_async_script(r"""
+const done = arguments[arguments.length-1]; const out = {};
+let t=performance.now(), s=0; for (let i=0;i<5e7;i++) s=(s+i*7)|0; out.js_ms=Math.round(performance.now()-t); out.js_sum=s;
+const w=new Uint8Array([0,97,115,109,1,0,0,0,1,7,1,96,2,127,127,1,127,3,2,1,0,7,7,1,3,97,100,100,0,0,10,9,1,7,0,32,0,32,1,106,11]);
+WebAssembly.instantiate(w).then(({instance})=>{ out.wasm_add=instance.exports.add(40,2);
+ const c=document.getElementById('c'), g=c.getContext('2d'); const st=c.captureStream(30);
+ const rec=new MediaRecorder(st,{mimeType:'video/webm'}); const ch=[]; rec.ondataavailable=e=>ch.push(e.data);
+ let f=0; const iv=setInterval(()=>{g.fillStyle='hsl('+(f++*20)+',80%,50%)';g.fillRect(0,0,64,64);},33);
+ rec.onstop=()=>{clearInterval(iv); const v=document.createElement('video'); v.muted=true; document.body.append(v);
+   v.src=URL.createObjectURL(new Blob(ch,{type:'video/webm'}));
+   v.onerror=()=>{out.video_err=v.error&&v.error.message; done(out);};
+   v.play().then(()=>setTimeout(()=>{out.video_time=v.currentTime; out.decoded=v.getVideoPlaybackQuality().totalVideoFrames; done(out);},1500)).catch(e=>{out.video_err=String(e);done(out);});};
+ rec.start(); setTimeout(()=>rec.stop(),2000);
+}).catch(e=>{out.wasm_err=String(e);done(out);});
+""")
+with m.using_context("chrome"):
+    jit = m.execute_script("return [Services.prefs.getBoolPref('javascript.options.baselinejit'), Services.prefs.getBoolPref('javascript.options.ion'), Services.prefs.getBoolPref('javascript.options.wasm'), Services.appinfo.XPCOMABI]")
+print(ARCH, "prefs(baseline,ion,wasm,abi):", jit, "result:", r)
+try:
+    with m.using_context("chrome"): m.execute_script("Services.startup.quit(Ci.nsIAppStartup.eAttemptQuit)")
+except Exception: pass
+p.wait(30); print(ARCH, "exit", p.returncode)
diff --git a/greatdane/tests/media_check.py b/greatdane/tests/media_check.py
new file mode 100644
index 0000000000..5bfd36ab92
--- /dev/null
+++ b/greatdane/tests/media_check.py
@@ -0,0 +1,62 @@
+# Media check on a build: real Widevine DASH playback (Shaka angel-one-widevine + Shaka no_auth license proxy)
+# and clear H.264 playback; reports decoder via mozRequestDebugInfo + MOZ_LOG PlatformDecoderModule.
+import os as _os, sys as _sys; _sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), "..", "tools"))
+import gd_guard  # must be first
+import sys, subprocess, time, json, os
+from marionette_driver.marionette import Marionette
+APP, ARCH = sys.argv[1], sys.argv[2]
+prof = gd_guard.profile("gd-test-")
+open(prof+"/user.js","w").write('user_pref("marionette.port", 2839);\nuser_pref("greatdane.node.dataDir", "%s");\nuser_pref("greatdane.pep.listen_port", 34875);\nuser_pref("greatdane.doge.listen_port", 23557);\nuser_pref("greatdane.legacy.certCleanup", false);\nuser_pref("greatdane.legacy.import", false);\nuser_pref("browser.shell.checkDefaultBrowser", false);\nuser_pref("media.autoplay.default", 0);\n' % gd_guard.ND)
+logf = os.path.join(gd_guard.ND, "moz.log")
+env = dict(os.environ, MOZ_LOG="PlatformDecoderModule:5,EME:3,sync", MOZ_LOG_FILE=logf)
+p = subprocess.Popen(["arch","-"+ARCH,APP,"-marionette","-remote-allow-system-access","-no-remote","-profile",prof],env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+m = Marionette(host="127.0.0.1", port=2839); m.start_session(); m.timeout.script = 240
+res = {"arch": ARCH}
+with m.using_context("chrome"):
+    res["install"] = m.execute_async_script("""const done=arguments[arguments.length-1];
+      const {GMPInstallManager}=ChromeUtils.importESModule("resource://gre/modules/GMPInstallManager.sys.mjs");
+      new GMPInstallManager().simpleCheckAndInstall().then(r=>done(JSON.stringify(r).slice(0,200)),e=>done('ERR '+e));""")
+    for _ in range(40):
+        v = m.execute_script("const g=n=>Services.prefs.getStringPref('media.'+n+'.version','');return {widevine:g('gmp-widevinecdm'),openh264:g('gmp-gmpopenh264')}")
+        if v["widevine"]: break
+        time.sleep(3)
+    res["versions"] = v
+PAGE = r"""(async()=>{const mpd=%s, lic=%s; const out=o=>document.body.setAttribute('data-res',JSON.stringify(o));
+ try{ await new Promise((ok,no)=>{const s=document.createElement('script');s.src='https://cdnjs.cloudflare.com/ajax/libs/shaka-player/4.11.7/shaka-player.compiled.js';s.onload=ok;s.onerror=()=>no(new Error('shaka load failed'));document.head.appendChild(s);});
+   shaka.polyfill.installAll(); const v=document.createElement('video'); v.muted=true; v.width=640; document.body.appendChild(v);
+   const pl=new shaka.Player(); await pl.attach(v); if(lic) pl.configure({drm:{servers:{'com.widevine.alpha':lic}}});
+   await pl.load(mpd); await v.play(); await new Promise(r=>setTimeout(r,12000));
+   const q=v.getVideoPlaybackQuality(); const vt=pl.getVariantTracks().find(t=>t.active)||{};
+   out({ok:v.currentTime>5&&q.totalVideoFrames>0,currentTime:v.currentTime,frames:q.totalVideoFrames,dropped:q.droppedVideoFrames,codecs:vt.videoCodec,height:vt.height,keySystem:pl.keySystem()});
+ }catch(e){out({ok:false,err:String(e&&e.code||'')+' '+String(e&&e.message||e)});}})();"""
+def play(mpd, lic):
+    m.navigate("https://example.com/")
+    m.execute_script("const s=document.createElement('script');s.textContent=arguments[0];document.body.appendChild(s);", script_args=[PAGE % (json.dumps(mpd), json.dumps(lic))])
+    for _ in range(60):
+        r = m.execute_script("return document.body.getAttribute('data-res')")
+        if r: break
+        time.sleep(2)
+    r = json.loads(r) if r else {"ok": False, "err": "timeout"}
+    try:
+        with m.using_context("chrome"):
+            r["debug"] = m.execute_async_script("""const done=arguments[arguments.length-1];
+              const b=gBrowser.selectedBrowser; done(null);""")
+    except Exception as e: pass
+    return r
+res["widevine_play"] = play("https://storage.googleapis.com/shaka-demo-assets/angel-one-widevine/dash.mpd","https://cwip-shaka-proxy.appspot.com/no_auth")
+res["h264_clear_play"] = play("https://storage.googleapis.com/shaka-demo-assets/angel-one/dash.mpd", None)
+print(json.dumps(res, indent=1))
+try:
+    with m.using_context("chrome"): m.execute_script("Services.startup.quit(Ci.nsIAppStartup.eAttemptQuit)")
+except Exception: pass
+p.wait(30)
+import glob, re
+lines=[l for f in glob.glob(logf+"*") for l in open(f,errors="replace")]
+keys=re.compile(r"(VideoToolbox|AppleVT|FFmpeg|FFVPX|ffvpx|OpenH264|ChromiumCDM|Widevine|GMP|AgnosticDecoder|Create.*Decoder|decoder description)",re.I)
+hits=[l.strip()[:220] for l in lines if keys.search(l)]
+print("MOZ_LOG lines:",len(lines),"matching:",len(hits))
+seen=set()
+for h in hits:
+    k=re.sub(r"^\S+ \S+ - ","",h)[:120]
+    if k not in seen: seen.add(k); print("  ",h)
+    if len(seen)>40: break
diff --git a/greatdane/tests/push_check.py b/greatdane/tests/push_check.py
new file mode 100644
index 0000000000..d510f8b627
