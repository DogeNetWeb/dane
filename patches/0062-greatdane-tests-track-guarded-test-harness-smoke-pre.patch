+++ b/greatdane/tests/push_check.py
@@ -0,0 +1,23 @@
+import os as _os, sys as _sys; _sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), "..", "tools"))
+import gd_guard  # must be first: real-profile guard + throwaway dirs
+import sys, subprocess, tempfile, time, json
+from marionette_driver.marionette import Marionette
+A,ARCH=sys.argv[1],sys.argv[2]; prof=gd_guard.profile("gd-push-")
+open(prof+"/user.js","w").write('user_pref("marionette.port", 2838);\nuser_pref("greatdane.node.dataDir", "' + gd_guard.ND + '");\nuser_pref("greatdane.pep.listen_port", 34874);\nuser_pref("greatdane.doge.listen_port", 23556);\nuser_pref("greatdane.legacy.certCleanup", false);\nuser_pref("greatdane.legacy.import", false);\nuser_pref("browser.shell.checkDefaultBrowser", false);\n')
+p=subprocess.Popen(["arch","-"+ARCH,A,"-marionette","-remote-allow-system-access","-no-remote","-profile",prof],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL)
+m=Marionette(host="127.0.0.1",port=2838); m.start_session(); m.timeout.script=90
+with m.using_context("chrome"):
+  pre=m.execute_script("""let g=n=>{try{return Services.prefs.getBoolPref(n)}catch(e){return 'unset'}};
+   return {enabled:g('dom.push.enabled'),conn:g('dom.push.connection.enabled'),server:Services.prefs.getStringPref('dom.push.serverURL','')}""")
+  if pre["conn"] is False: m.execute_script("Services.prefs.setBoolPref('dom.push.connection.enabled', true)")
+  r=m.execute_async_script("""const done=arguments[arguments.length-1]; const out={};
+   const ps=Cc['@mozilla.org/push/Service;1'].getService(Ci.nsIPushService);
+   const pr=Services.scriptSecurityManager.createContentPrincipal(Services.io.newURI('https://greatdane.example/'),{});
+   Services.perms.addFromPrincipal(pr,'desktop-notification',Services.perms.ALLOW_ACTION);
+   const go=()=>ps.subscribe('https://greatdane.example/sw', pr, (st, sub)=>{out.status='0x'+(st>>>0).toString(16); out.ok=Components.isSuccessCode(st)&&!!sub;
+        out.endpointHost=sub? new URL(sub.endpoint).host : null;
+        if(sub) ps.unsubscribe('https://greatdane.example/sw', pr, (s2,ok)=>{out.unsub=ok; done(out)}); else done(out);});
+   setTimeout(go,5000); setTimeout(()=>done(Object.assign(out,{timeout:true})),80000);""")
+print(json.dumps({"arch":ARCH,"pre":pre,"sub":r}))
+print("RESULT","PASS" if pre["enabled"] is True and r.get("ok") else "FAIL")
+m.delete_session(); p.terminate(); p.wait(30)
diff --git a/greatdane/tests/run_gd_prefs.py b/greatdane/tests/run_gd_prefs.py
new file mode 100644
index 0000000000..c85bde3f96
--- /dev/null
+++ b/greatdane/tests/run_gd_prefs.py
@@ -0,0 +1,153 @@
+# Dane settings tests in the built Dane (chrome context via Marionette):
+# the Dane pane loads, its toggles write prefs, Mozilla promo/data-collection
+# sections are hidden, Sync is visible by default and hidden by
+# greatdane.prefs.hideSync, and the first-run update window logic.
+#   python3 run_gd_prefs.py [path/to/greatdane] [screens_dir]
+import os as _os, sys as _sys; _sys.path.insert(0, _os.path.join(_os.path.dirname(_os.path.abspath(__file__)), "..", "tools"))
+import gd_guard  # must be first: real-profile guard + throwaway dirs
+import os, shutil, subprocess, sys, tempfile, time
+from marionette_driver.marionette import Marionette
+HERE = os.path.dirname(os.path.abspath(__file__))
+TREE = os.path.abspath(os.path.join(HERE, "../.."))
+APP = sys.argv[1] if len(sys.argv) > 1 else TREE + "/obj-gd/dist/Dane.app/Contents/MacOS/greatdane"
+SHOTS = sys.argv[2] if len(sys.argv) > 2 else None
+prof = gd_guard.profile("gd-prefs-")
+open(prof + "/user.js", "w").write('user_pref("marionette.port", 2833);\nuser_pref("greatdane.node.dataDir", "' + gd_guard.ND + '");\nuser_pref("greatdane.pep.listen_port", 34874);\nuser_pref("greatdane.doge.listen_port", 23556);\nuser_pref("browser.aboutwelcome.enabled", false);\n')
+p = subprocess.Popen([APP, "--headless", "--marionette", "-remote-allow-system-access", "--no-remote", "--profile", prof,
+                      "--width", "1280", "--height", "900"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+fails = 0
+def check(name, ok, info=""):
+    global fails
+    print(("PASS " if ok else "FAIL ") + name + (f"  [{info}]" if info and not ok else ""))
+    fails += 0 if ok else 1
+
+OPEN = '''let [pane, done] = arguments;
+let w = Services.wm.getMostRecentWindow("navigator:browser");
+w.openPreferences(pane);
+let t0 = Date.now();
+(function poll() {
+  let d = w.gBrowser.selectedBrowser.contentDocument;
+  let ok = d && d.readyState == "complete" && d.documentElement.getAttribute("data-gd-ready") != null;
+  if (d && d.readyState == "complete" && d.getElementById("gd-hide-style") && (Date.now() - t0) > 1500) return done(true);
+  if (Date.now() - t0 > 30000) return done(false);
+  w.setTimeout(poll, 200);
+})();'''
+JS = '''let d = Services.wm.getMostRecentWindow("navigator:browser").gBrowser.selectedBrowser.contentDocument;
