From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nowon <nowon@noreply.pepecoin.surf>
Date: Sat, 24 Oct 2026 23:55:04 -0500
Subject: [PATCH 007/144] greatdane: keep stock Firefox media plugins
 (OpenH264/Widevine GMP downloads), EME and Web Push; quiet-launch keeps only
 first-run/telemetry/update suppression

---
 browser/app/profile/firefox.js | 12 ------------
 1 file changed, 12 deletions(-)

diff --git a/browser/app/profile/firefox.js b/browser/app/profile/firefox.js
index f995c2c201..2e7354b8f2 100644
--- a/browser/app/profile/firefox.js
+++ b/browser/app/profile/firefox.js
@@ -3705,18 +3705,6 @@ pref("extensions.systemAddon.update.url", "");
 pref("browser.region.network.url", "");
 pref("browser.region.update.enabled", false);
 pref("geo.provider.network.url", "");
-// Media plugins: no OpenH264/Widevine auto-download (aus5, openh264.org, Google CDN)
-pref("media.gmp-manager.url", "");
-pref("media.gmp-manager.updateEnabled", false);
-pref("media.gmp-gmpopenh264.autoupdate", false);
-pref("media.gmp-gmpopenh264.enabled", false);
-pref("media.gmp-widevinecdm.autoupdate", false);
-pref("media.gmp-widevinecdm.visible", false);
-pref("media.gmp-widevinecdm.enabled", false);
-pref("media.eme.enabled", false);
-// Web Push: no persistent socket to push.services.mozilla.com
-pref("dom.push.connection.enabled", false);
-pref("dom.push.serverURL", "");
 // Prefetch/speculation towards sites the user didn't open
 pref("network.prefetch-next", false);
 pref("network.dns.disablePrefetch", true);
