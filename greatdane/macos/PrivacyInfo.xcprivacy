<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Dane privacy manifest (Contents/Resources/PrivacyInfo.xcprivacy).
  Installed by browser/app/Makefile.in (repackage) and listed in browser/installer/package-manifest.in.
  Optional for Developer ID distribution; kept accurate anyway. Rationale for every entry:
  greatdane/macos/PRIVACY-MANIFEST.md.

  Tracking: none. No tracking domains. Dane ships no ad or analytics SDKs.
  Dane update check: declared under OtherDiagnosticData (not linked, not tracking; used for app
  functionality only). Requests go to https://dane.surf/update/.... For the Dane update check the
  purpose is AppFunctionality only; the entry also carries Analytics because of Mozilla's opt-in
  telemetry. Ruling text (dane.surf update-check logs, format dane_update_masked, as of
  Curb Appeal release 20261111-0308):
    The automatic update check sends product, version, build ID, target, locale and channel to Dane's
    update server (dane.surf). Dane's update checks to dane.surf are written to dane-update.log in the
    dane_update_masked format: those lines record product, version, platform and channel, plus the
    request status, the user agent and a masked IP (/24 for IPv4, /48 for IPv6). Build ID and locale
    are replaced with '-', and query strings and referrers are not logged in those lines. This wording
    describes those dane.surf update-check log lines; it does not describe the server's default log.
    Rare server-error logs can contain a full IP. Logs are kept about 14 days, are not linked to an
    account or device, and are not shared. Before November 10, 2026, update-check log entries on pepecoin.surf
    kept full client IP addresses; they rotate out around November 25, 2026. Before the November 10, 2026
    logging change, dane.surf's own access-log lines already masked the IP address, but update-check lines
    recorded the full request path, including build ID and locale; they sat in a shared server log that
    also held unmasked lines from other hosts. Those logs rotate out within about 14 days. No check
    happens while the DisableAppUpdate policy is on. The update URL is
    https://dane.surf/update/3/.... This unofficial build does not publish update.xml.
    https://dane.surf/releases/ 301s to /download/ (as of 2026-11-10). This update-log wording matches
    the live dane.surf /update/ location (format dane_update_masked; build ID and locale replaced
    with '-') as of Curb Appeal release 20261111-0308 (November 10, 2026, 9:08 PM CST).
  Dane's servers otherwise see only pages the user chooses to open.
  Default new-tab tile icons for dane.surf, greatdane.doge and grokipedia.com are
  bundled (tippytop; grokipedia.com uses our own letter tile), so showing the new-tab page contacts
  none of those sites. A user-initiated load of a Dane site is ordinary browsing.
  Collected data: the entries below are conservative and cover stock Firefox services that Dane keeps
  (Mozilla is the receiving party), with one exception: Dane itself (dane.surf) receives the
  update-check data, declared under OtherDiagnosticData:
    - EmailAddress: only if the user signs in to a Mozilla account (Sync). Linked.
    - DeviceID: random per-install IDs (Web Push UAID; Glean client_id only if the user opts in).
    - CoarseLocation: stock region (country) lookup from IP via location.services.mozilla.com.
    - ProductInteraction / PerformanceData: only if the user turns data collection ON in Settings.
      Dane ships it OFF (datareporting.healthreport.uploadEnabled=false, toolkit.telemetry.enabled=false,
      toolkit.telemetry.server="data:,").
    - OtherDiagnosticData (AppFunctionality, Analytics): NOT opt-in only. The default-on GMP (OpenH264 /
      Widevine) update check to aus5.mozilla.org sends version, build ID, build target (OS + arch),
      locale, channel, OS version and distribution ID/version (media.gmp-manager.url). Also the Dane update-check log at
      dane.surf (above; AppFunctionality only, receiver: Dane). Analytics covers only the opt-in
      telemetry diagnostics.
  Not collected: crash data (crash reporter is local-only, empty ServerURL), browsing/search history
  (Safe Browsing sends hash prefixes only; Sync data is end-to-end encrypted), precise location
  (macOS CoreLocation, per-site user permission, delivered to the requesting site only).
  UserDefaults CA92.1: Dane's own defaults domain, plus the Dock and login-window preferences the
  user's own Dock/session settings use (com.apple.dock read/write, com.apple.loginwindow read).
  See PRIVACY-MANIFEST.md for why this is stated openly.
-->
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeCoarseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeProductInteraction</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePerformanceData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<false/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
				<string>3B52.1</string>
				<string>DDA9.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
				<string>8FFB.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>E174.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
